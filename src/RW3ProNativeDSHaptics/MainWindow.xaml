<Window x:Class="RW3ProNativeDSHaptics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RW3 Pro Haptics"
        Icon="Assets/App.ico"
        Width="1000" Height="860" MinWidth="960" MinHeight="780"
        Background="#0B1222" Foreground="#EEF3FF" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded"
        Closing="Window_Closing" StateChanged="Window_StateChanged">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="28,20,28,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- HEADER + TABS -->
    <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="RW3 Pro Haptics" FontSize="22" FontWeight="Bold"/>
        <TextBlock Text="Wolverine V3 Pro • DualSense haptics" Style="{StaticResource Hint}"/>
      </StackPanel>
      <Border Grid.Column="1" HorizontalAlignment="Center" Background="#101A2E" CornerRadius="12" Padding="5">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="TabGeneral" Content="Genel kullanım" GroupName="Tabs" Style="{StaticResource TabButton}" IsChecked="True" Checked="Tab_Checked"/>
          <RadioButton x:Name="TabRgb" Content="RGB" GroupName="Tabs" Style="{StaticResource TabButton}" Checked="Tab_Checked"/>
          <RadioButton x:Name="TabShortcuts" Content="Tuşlar &amp; Kısayollar" GroupName="Tabs" Style="{StaticResource TabButton}" Checked="Tab_Checked"/>
          <RadioButton x:Name="TabTest" Content="Test" GroupName="Tabs" Style="{StaticResource TabButton}" Checked="Tab_Checked"/>
          <RadioButton x:Name="TabSettings" Content="Ayarlar" GroupName="Tabs" Style="{StaticResource TabButton}" Checked="Tab_Checked"/>
        </StackPanel>
      </Border>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Border x:Name="BatteryBadge" Background="#1A2740" CornerRadius="20" Padding="13,7" Margin="0,0,10,0" VerticalAlignment="Center"
                ToolTip="Kolun pil ve şarj durumu (Razer HID 07/80 &amp; 07/84 veya XInput)">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="BatteryBadgeDot" Width="8" Height="8" Fill="{StaticResource Muted}" Margin="0,0,7,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="BatteryBadgeText" Text="🔋 —" FontWeight="SemiBold" FontSize="12.5"/>
          </StackPanel>
        </Border>
        <Border x:Name="RunBadge" Background="#1A2740" CornerRadius="20" Padding="14,7" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="RunBadgeDot" Width="9" Height="9" Fill="{StaticResource Muted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="RunBadgeText" Text="Kapalı" FontWeight="SemiBold"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <!-- ===================== GENEL KULLANIM ===================== -->
    <Grid x:Name="GeneralPage" Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>

      <!-- First-start guide: one question, three answers; sets the best defaults for that answer. -->
      <Border x:Name="GuidePanel" Grid.ColumnSpan="3" Panel.ZIndex="20" Visibility="Collapsed" Background="#F20B1322" CornerRadius="14">
        <Border Background="#121C31" CornerRadius="16" Padding="30,24" MaxWidth="700" VerticalAlignment="Center" HorizontalAlignment="Center"
                BorderBrush="{StaticResource Accent}" BorderThickness="2">
          <StackPanel>
            <TextBlock Text="Hoş geldin! Kolunu nasıl kullanmak istersin?" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock x:Name="GuidePadText" Style="{StaticResource Hint}" FontSize="13" Margin="0,6,0,16"/>
            <Button x:Name="GuideAudioBtn" Style="{StaticResource GuideBtn}" Tag="Audio" Click="GuideChoice_Click">
              <StackPanel>
                <TextBlock Text="Her oyunda titreşim (önerilen)" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Oyunun sesi avuçlarda titreşir. Her oyun, film ve müzikle çalışır; kurulum gerekmez." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
              </StackPanel>
            </Button>
            <Button x:Name="GuideNativeBtn" Style="{StaticResource GuideBtn}" Tag="Native" Click="GuideChoice_Click">
              <StackPanel>
                <TextBlock Text="DualSense destekli oyunlar" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="PlayStation oyunlarının PC sürümleri gibi: tetik efektleri ve oyunun kendi haptiği. Bir kez yönetici izni ister." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
              </StackPanel>
            </Button>
            <Button x:Name="GuideNormalBtn" Style="{StaticResource GuideBtn}" Tag="Normal" Click="GuideChoice_Click">
              <StackPanel>
                <TextBlock Text="Uygulama karışmasın" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Kol normal bir Xbox kolu gibi çalışır; oyunun kendi titreşimi olduğu gibi gider." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
              </StackPanel>
            </Button>
            <CheckBox x:Name="GuideAutostart" Content="Windows açılınca arka planda başlat (önerilen)" Foreground="#EEF3FF" IsChecked="True" Margin="0,4,0,0"/>
            <TextBlock Text="Seçimini sonra Genel sekmesinden değiştirebilirsin; bu rehber Ayarlar → Başlangıç rehberini aç ile yeniden açılır." Style="{StaticResource Hint}" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
      </Border>

      <Border Style="{StaticResource CardBorder}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Bağlantılar" Style="{StaticResource CardTitle}"/>
          <TextBlock DockPanel.Dock="Top" Text="Kolun ve gereken parçaların durumu." Style="{StaticResource Hint}" Margin="0,0,0,14"/>
          <Button DockPanel.Dock="Bottom" Content="↻  Yeniden kontrol et" Style="{StaticResource SmallBtn}" HorizontalAlignment="Left" Click="RefreshChecks_Click"/>
          <StackPanel x:Name="CheckList">
            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Ellipse x:Name="DotWolverine" Width="11" Height="11" VerticalAlignment="Top" Margin="0,4,0,0" Fill="{StaticResource Muted}"/>
              <StackPanel Grid.Column="1"><TextBlock Text="Wolverine V3 Pro" FontWeight="SemiBold"/><TextBlock x:Name="HintWolverine" Style="{StaticResource Hint}"/></StackPanel>
            </Grid>
            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Ellipse x:Name="DotSynapse" Width="11" Height="11" VerticalAlignment="Top" Margin="0,4,0,0" Fill="{StaticResource Muted}"/>
              <StackPanel Grid.Column="1"><TextBlock Text="Avuç haptiği (Sensa)" FontWeight="SemiBold"/><TextBlock x:Name="HintSynapse" Style="{StaticResource Hint}"/></StackPanel>
            </Grid>
            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Ellipse x:Name="DotSdk" Width="11" Height="11" VerticalAlignment="Top" Margin="0,4,0,0" Fill="{StaticResource Muted}"/>
              <StackPanel Grid.Column="1"><TextBlock Text="Sanal DualSense sürücüsü" FontWeight="SemiBold"/><TextBlock x:Name="HintSdk" Style="{StaticResource Hint}"/></StackPanel>
            </Grid>
            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Ellipse x:Name="DotDualSense" Width="11" Height="11" VerticalAlignment="Top" Margin="0,4,0,0" Fill="{StaticResource Muted}"/>
              <StackPanel Grid.Column="1"><TextBlock Text="DualSense köprüsü" FontWeight="SemiBold"/><TextBlock x:Name="HintDualSense" Style="{StaticResource Hint}"/></StackPanel>
            </Grid>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition/></Grid.RowDefinitions>

        <!-- what is running right now: always visible above the options -->
        <Border Style="{StaticResource CardBorder}" Padding="20,14">
          <StackPanel>
            <TextBlock x:Name="StatusTitle" Text="Hazır" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="StatusDetail" Style="{StaticResource Hint}" Margin="0,3,0,0" FontSize="12.5"/>
            <Grid x:Name="LevelPanel" Margin="0,10,0,0" Visibility="Collapsed">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Text="Sol" Foreground="{StaticResource Muted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <ProgressBar x:Name="LeftLevel" Grid.Column="1" Style="{StaticResource LevelBar}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="3" Text="Sağ" Foreground="{StaticResource Muted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <ProgressBar x:Name="RightLevel" Grid.Column="4" Style="{StaticResource LevelBar}" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="ModeNote" Style="{StaticResource Hint}" FontSize="12" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Oyuna görünen kol" Style="{StaticResource CardTitle}"/>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,10"
                       Text="Oyun kolunu hangi kol olarak görsün? Seçim hemen ve her açılışta uygulanır. Kumandada ☰ kombinasyonu sıradakine geçer."/>
            <!-- internal pipelines the selector maps to (OutputMatrix.Plan); not shown -->
            <UniformGrid DockPanel.Dock="Top" Columns="3" Visibility="Collapsed">
              <RadioButton x:Name="ModeNormal" GroupName="Mode" Checked="Mode_Checked"/>
              <RadioButton x:Name="ModeAudio" GroupName="Mode" Checked="Mode_Checked"/>
              <RadioButton x:Name="ModeNative" GroupName="Mode" Checked="Mode_Checked"/>
            </UniformGrid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,0" Focusable="False">
            <StackPanel Margin="0,0,10,0">
            <Border Background="#0B1222" CornerRadius="14" Padding="5,6">
              <UniformGrid Columns="5">
                <RadioButton x:Name="OutPhysical" GroupName="Output" Tag="Physical" Style="{StaticResource OutputTile}" Checked="Output_Checked" AutomationProperties.Name="Kolun kendisi">
                  <StackPanel>
                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                    <TextBlock Text="Kolun kendisi" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    <TextBlock Text="Wolverine" FontSize="10.5" Opacity="0.75" HorizontalAlignment="Center"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="OutXbox360" GroupName="Output" Tag="Xbox360" Style="{StaticResource OutputTile}" Checked="Output_Checked" AutomationProperties.Name="Xbox 360">
                  <StackPanel>
                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                    <TextBlock Text="Xbox 360" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    <TextBlock Text="XInput" FontSize="10.5" Opacity="0.75" HorizontalAlignment="Center"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="OutXboxSeries" GroupName="Output" Tag="XboxSeries" Style="{StaticResource OutputTile}" Checked="Output_Checked" AutomationProperties.Name="Xbox Series">
                  <StackPanel>
                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                    <TextBlock Text="Xbox Series" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    <TextBlock Text="tetikli" FontSize="10.5" Opacity="0.75" HorizontalAlignment="Center"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="OutDualShock4" GroupName="Output" Tag="DualShock4" Style="{StaticResource OutputTile}" Checked="Output_Checked" AutomationProperties.Name="PS4">
                  <StackPanel>
                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                    <TextBlock Text="PS4" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    <TextBlock Text="DualShock 4" FontSize="10.5" Opacity="0.75" HorizontalAlignment="Center"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="OutDualSense" GroupName="Output" Tag="DualSense" Style="{StaticResource OutputTile}" Checked="Output_Checked" AutomationProperties.Name="DualSense">
                  <StackPanel>
                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                    <TextBlock Text="DualSense" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    <TextBlock Text="PS5" FontSize="10.5" Opacity="0.75" HorizontalAlignment="Center"/>
                  </StackPanel>
                </RadioButton>
              </UniformGrid>
            </Border>
            <TextBlock x:Name="OutputHint" Style="{StaticResource Hint}" Margin="2,8,0,6" TextWrapping="Wrap"/>
            <Border x:Name="OutputWarningBox" Background="#3A2A10" CornerRadius="8" Padding="10,6" Margin="0,0,0,8" Visibility="Collapsed">
              <TextBlock x:Name="OutputWarning" Foreground="{StaticResource Warn}" FontSize="12" TextWrapping="Wrap"/>
            </Border>
            <!-- Xbox Series only: which HIDMaestro One/Series pad the game sees (games accept different ones) -->
            <Grid x:Name="SeriesTypeRow" Margin="2,0,0,8" Visibility="Collapsed">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Text="Series kol türü" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <ComboBox x:Name="SeriesTypeCombo" Grid.Column="1" MinHeight="32" DisplayMemberPath="Display" SelectedValuePath="Profile"
                        SelectionChanged="SeriesType_Changed" AutomationProperties.Name="Series kol türü"/>
            </Grid>
            <Border Background="#0F1829" CornerRadius="12" Padding="10,8" BorderBrush="{StaticResource Line}" BorderThickness="1">
              <StackPanel>
                <Grid x:Name="FeatureMatrix"/>
                <TextBlock x:Name="MatrixLegend" Style="{StaticResource Hint}" FontSize="11.5" Margin="4,6,0,0" TextWrapping="Wrap"
                           Text="● açık · ○ kapalı · ✓ o kolda var · — yok · oyun: oyunun kendisi sürer. Başka bir kolun hücresine tıklayınca o kola geçilir."/>
                <TextBlock x:Name="MatrixPadNote" Style="{StaticResource Hint}" FontSize="11.5" Margin="4,2,0,0" TextWrapping="Wrap"/>
                <!-- levels of the game's feedback rows (shown when the row is on and RW3 drives it) -->
                <Grid x:Name="RumbleLevelRow" Margin="4,10,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Oyunun rumble seviyesi" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Slider x:Name="NativeRumbleLevel" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True"
                          VerticalAlignment="Center" ValueChanged="NativeRumbleLevel_Changed" AutomationProperties.Name="Oyunun rumble seviyesi"/>
                  <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=NativeRumbleLevel, StringFormat='%{0:0}'}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <Grid x:Name="TriggerLevelRow" Margin="4,6,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Tetik motoru seviyesi" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Slider x:Name="MatrixTriggerLevel" Grid.Column="1" Minimum="0" Maximum="200" SmallChange="5" LargeChange="25" TickFrequency="5" IsSnapToTickEnabled="True"
                          VerticalAlignment="Center" ValueChanged="MatrixTriggerLevel_Changed" AutomationProperties.Name="Tetik motoru titreşim seviyesi"/>
                  <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=MatrixTriggerLevel, StringFormat='%{0:0}'}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="LevelRowsHint" Style="{StaticResource Hint}" FontSize="11.5" Margin="4,2,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border Height="14"/>
            <StackPanel x:Name="NormalSourceRows" Visibility="Collapsed">
              <TextBlock Text="Xbox kolu destekleyen oyunlarda seç. Wolverine Xbox modundayken standart gövde titreşimi ve oyun gönderiyorsa tetik içi titreşim doğrudan kola gider." Style="{StaticResource Hint}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel x:Name="AudioSourceRows" Visibility="Collapsed">
              <TextBlock Text="Bilgisayarın sesi titreşime çevrilir: PC modunda ve Xbox modunda avuçlar (Sensa), Sensa kapalıysa gövde motorları." Style="{StaticResource Hint}"/>
              <!-- level (shared with the native mode's sound source) -->
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
                <TextBlock Text="Titreşim seviyesi" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Slider x:Name="AudioLevelSlider" Grid.Column="1" Minimum="10" Maximum="300" SmallChange="5" LargeChange="25" TickFrequency="5"
                        IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="AudioLevel_Changed" AutomationProperties.Name="Sesten titreşim seviyesi"/>
                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=AudioLevelSlider, StringFormat='%{0:0}'}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock Text="%100 = sesin kendi seviyesi. Hemen uygulanır." Style="{StaticResource Hint}"/>
              <TextBlock Text="Hangi ses titreşsin?" FontWeight="SemiBold" Margin="0,10,0,2"/>
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ScopeAll" GroupName="AudioScopeA" Tag="AllSystem" Content="Bilgisayarın tüm sesi" Foreground="#EEF3FF" Margin="0,0,18,0" Checked="AudioScope_Checked"/>
                <RadioButton x:Name="ScopeApp" GroupName="AudioScopeA" Tag="ForegroundApp" Content="Yalnız öndeki uygulama (oyun)" Foreground="#EEF3FF" Checked="AudioScope_Checked"/>
              </StackPanel>
              <TextBlock Text="Öndeki uygulama: oynadığın oyunun sesi titreşir; arka plandaki YouTube, Discord, müzik titreşmez. Oyuna geçince kendiliğinden ona döner; bu pencere öndeyken son oyun dinlenmeye devam eder." Style="{StaticResource Hint}"/>
              <CheckBox x:Name="AudioStandard" Content="Standart (DSX gibi): ses olduğu gibi, sessizlikte durur" Foreground="#EEF3FF" Margin="0,8,0,0"
                        Checked="AudioShaping_Changed" Unchecked="AudioShaping_Changed"/>
              <TextBlock Text="Önerilen. Kısık ses zayıf, yüksek ses güçlü titreşir; çok sessiz kısımlarda titreşim tamamen kesilir." Style="{StaticResource Hint}"/>
              <CheckBox x:Name="AudioMelody" Content="Melodi modu (önerilen): bas ve melodi avuçlarda tanınır biçimde çalar" Foreground="#EEF3FF" Margin="0,8,0,0"
                        Checked="AudioMelody_Changed" Unchecked="AudioMelody_Changed"/>
              <TextBlock Text="Bir el iki ton çalar: bas kendi frekansında, melodi (vokal, solo) bir iki oktav aşağıda; kolu kulağına dayayınca ezgi duyulur, sözler duyulmaz. Patlama, silah gibi perdesiz güçlü vuruşlarda o el kendiliğinden Standart'a geçer. Kapalıyken Standart: tek ton, en hızlı tepki." Style="{StaticResource Hint}"/>

              <CheckBox x:Name="AudioRumbleFallback" Content="Xbox modu: tarayıcı/Claude öndeyken titreşim rumble ile devam etsin" Foreground="#EEF3FF" Margin="0,8,0,0"
                        Checked="RumbleFallback_Changed" Unchecked="RumbleFallback_Changed"/>
              <TextBlock Text="Opera, Chrome, Claude, Codex gibi uygulamalar öndeyken Windows avuçları (Sensa) engeller. Açık: o sırada rumble motorları çalar (daha kaba). Kapalı: titreşim o sırada durur, hissettiğin her şey Sensa olur. Oyunlarda etkisi yok." Style="{StaticResource Hint}"/>

              <Expander Header="Gelişmiş ses ayarları" Foreground="#EEF3FF" Margin="0,12,0,0">
                <StackPanel Margin="4,6,0,0">
                  <TextBlock Text="Frekans filtresi" FontWeight="SemiBold" Margin="0,0,0,2"/>
                  <RadioButton x:Name="AudioProfileExisting" GroupName="AudioProfile" Tag="Existing" Content="Tam haptik bant (önerilen)" Foreground="#EEF3FF" Checked="AudioProfile_Checked"/>
                  <RadioButton x:Name="AudioProfileControlled" GroupName="AudioProfile" Tag="Controlled" Content="Derin bas (30–130 Hz)" Foreground="#EEF3FF" Checked="AudioProfile_Checked"/>
                  <RadioButton x:Name="AudioProfileBalanced" GroupName="AudioProfile" Tag="Balanced" Content="Bas (30–150 Hz)" Foreground="#EEF3FF" Checked="AudioProfile_Checked"/>
                  <RadioButton x:Name="AudioProfileDynamic" GroupName="AudioProfile" Tag="Dynamic" Content="Hafif iki bant (30–200 Hz)" Foreground="#EEF3FF" Checked="AudioProfile_Checked"/>
                  <TextBlock x:Name="AudioProfileHint" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                  <TextBlock Text="Seviye işleme (Standart kapalıyken)" FontWeight="SemiBold" Margin="0,10,0,2"/>
                  <CheckBox x:Name="AudioAutoLevel" Content="Otomatik seviye: kısık sesi yükseltir, çok yükseği kısar" Foreground="#EEF3FF"
                            Checked="AudioShaping_Changed" Unchecked="AudioShaping_Changed"/>
                  <CheckBox x:Name="AudioHumSuppression" Content="Uğultu bastırma: sürekli sesi kısar, vuruşları öne çıkarır" Foreground="#EEF3FF" Margin="0,4,0,0"
                            Checked="AudioShaping_Changed" Unchecked="AudioShaping_Changed"/>
                  <TextBlock Text="İkisi de oyunun sessiz anlarında da titreşim üretebilir; sürekli titreşim hissedersen Standart'a dön." Style="{StaticResource Hint}"/>
                  <CheckBox x:Name="XboxBassTreble" Content="Gövde motorları: bas büyük motora, tiz küçük motora" Foreground="#EEF3FF" Margin="0,10,0,0"
                            IsEnabled="False" Checked="XboxBassTreble_Changed" Unchecked="XboxBassTreble_Changed"
                            AutomationProperties.Name="Xbox modunda bas büyük motora, tiz küçük motora"/>
                  <TextBlock x:Name="XboxBassTrebleHint" Style="{StaticResource Hint}" Text="Yalnız kol Xbox modundayken ve ses gövde motorlarına giderken."/>
                </StackPanel>
              </Expander>
            </StackPanel>
            <StackPanel x:Name="NativeSourceRows" Visibility="Collapsed">
              <TextBlock Text="DualSense ayarları" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <UniformGrid Columns="3" Visibility="Collapsed">
                <RadioButton x:Name="NativeSrcGame" GroupName="NativeSrc" Tag="Game" Style="{StaticResource ChoiceCard}" Margin="0,0,8,0" Checked="NativeSource_Checked">
                  <StackPanel><TextBlock Text="Oyunun HD haptiği" FontWeight="SemiBold"/><TextBlock Text="Oyun DualSense haptiği gönderiyorsa" Style="{StaticResource Hint}"/></StackPanel>
                </RadioButton>
                <RadioButton x:Name="NativeSrcAudio" GroupName="NativeSrc" Tag="Audio" Style="{StaticResource ChoiceCard}" Margin="0,0,8,0" Checked="NativeSource_Checked">
                  <StackPanel><TextBlock Text="Oyun sesinden" FontWeight="SemiBold"/><TextBlock Text="Tetik var, haptik yoksa" Style="{StaticResource Hint}"/></StackPanel>
                </RadioButton>
                <RadioButton x:Name="NativeSrcOff" GroupName="NativeSrc" Tag="Off" Style="{StaticResource ChoiceCard}" Checked="NativeSource_Checked">
                  <StackPanel><TextBlock Text="Kapalı" FontWeight="SemiBold"/><TextBlock Text="Yalnız tetik ve titreşim" Style="{StaticResource Hint}"/></StackPanel>
                </RadioButton>
              </UniformGrid>
              <TextBlock x:Name="NativeSourceHint" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
              <StackPanel x:Name="NativeScopeRow" Orientation="Horizontal" Margin="0,6,0,0">
                <RadioButton x:Name="NativeScopeAll" GroupName="AudioScopeN" Tag="AllSystem" Content="Bilgisayarın tüm sesi" Foreground="#EEF3FF" Margin="0,0,18,0" Checked="AudioScope_Checked"/>
                <RadioButton x:Name="NativeScopeApp" GroupName="AudioScopeN" Tag="ForegroundApp" Content="Yalnız öndeki uygulama (oyun)" Foreground="#EEF3FF" Checked="AudioScope_Checked"/>
