<Window x:Class="RW3ProNativeDSHaptics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RW3 Pro Haptics"
        Icon="Assets/App.ico"
        Width="1000" Height="800" MinWidth="960" MinHeight="780"
        Background="#0B1222" Foreground="#EEF3FF" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded"
        Closing="Window_Closing" StateChanged="Window_StateChanged">
  <Window.Resources>
    <SolidColorBrush x:Key="Card" Color="#121C31"/>
    <SolidColorBrush x:Key="CardHover" Color="#18243D"/>
    <SolidColorBrush x:Key="Line" Color="#22304D"/>
    <SolidColorBrush x:Key="Muted" Color="#93A2BF"/>
    <SolidColorBrush x:Key="Accent" Color="#3D7BFF"/>
    <SolidColorBrush x:Key="Good" Color="#3DD68C"/>
    <SolidColorBrush x:Key="Bad" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="Warn" Color="#FFB547"/>

    <Style x:Key="CardBorder" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Card}"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="20,18"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Background" Value="#22304D"/>
      <Setter Property="Foreground" Value="#EEF3FF"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"
                  BorderBrush="Transparent" BorderThickness="2">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#FFFFFF"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.85"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.35"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Padding" Value="26,13"/>
    </Style>
    <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Padding" Value="11,6"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <!-- Top navigation tabs -->
    <Style x:Key="TabButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="4,0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="RadioButton">
          <Border x:Name="B" Background="Transparent" CornerRadius="9" Padding="16,7" BorderBrush="Transparent" BorderThickness="2">
            <ContentPresenter HorizontalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#16213A"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="B" Property="Background" Value="#22304D"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#FFFFFF"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>

    <!-- Selectable cards (modes, intensity presets) -->
    <Style x:Key="ChoiceCard" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#EEF3FF"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="RadioButton">
          <Border x:Name="B" Background="#0F1829" BorderBrush="{StaticResource Line}" BorderThickness="2"
                  CornerRadius="12" Padding="16,14">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#16213A"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}"/>
              <Setter TargetName="B" Property="Background" Value="#172443"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#FFFFFF"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PresetCard" TargetType="RadioButton" BasedOn="{StaticResource ChoiceCard}">
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Width" Value="78"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DeviceChip" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#C9D6F0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="RadioButton">
          <Border x:Name="B" Background="#0F1829" BorderBrush="{StaticResource Line}" BorderThickness="2" CornerRadius="8" Padding="12,4">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}"/>
              <Setter TargetName="B" Property="Background" Value="#172443"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#FFFFFF"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LevelBar" TargetType="ProgressBar">
      <Setter Property="Height" Value="8"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="Background" Value="#0B1222"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
  </Window.Resources>

  <Grid Margin="28,20,28,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- HEADER + TABS -->
    <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="RW3 Pro Haptics" FontSize="22" FontWeight="Bold"/>
        <TextBlock Text="Wolverine V3 Pro • DualSense haptics" Style="{StaticResource Hint}"/>
      </StackPanel>
      <Border Grid.Column="1" HorizontalAlignment="Center" Background="#101A2E" CornerRadius="12" Padding="5">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="TabGeneral" Content="Genel kullanım" GroupName="Tabs" Style="{StaticResource TabButton}" IsChecked="True" Checked="Tab_Checked"/>
          <RadioButton x:Name="TabTest" Content="Test" GroupName="Tabs" Style="{StaticResource TabButton}" Checked="Tab_Checked"/>
          <RadioButton x:Name="TabSettings" Content="Ayarlar" GroupName="Tabs" Style="{StaticResource TabButton}" Checked="Tab_Checked"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" x:Name="RunBadge" Background="#1A2740" CornerRadius="20" Padding="14,7" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="RunBadgeDot" Width="9" Height="9" Fill="{StaticResource Muted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="RunBadgeText" Text="Kapalı" FontWeight="SemiBold"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ===================== GENEL KULLANIM ===================== -->
    <Grid x:Name="GeneralPage" Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>

      <Border Style="{StaticResource CardBorder}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Bağlantılar" Style="{StaticResource CardTitle}"/>
          <TextBlock DockPanel.Dock="Top" Text="Bağlantı kontrolleri oyun kaynağını veya fiziksel HD çıkışı doğrulamaz." Style="{StaticResource Hint}" Margin="0,0,0,14"/>
          <Button DockPanel.Dock="Bottom" Content="↻  Yeniden kontrol et" Style="{StaticResource SmallBtn}" HorizontalAlignment="Left" Click="RefreshChecks_Click"/>
          <StackPanel x:Name="CheckList">
            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Ellipse x:Name="DotWolverine" Width="11" Height="11" VerticalAlignment="Top" Margin="0,4,0,0" Fill="{StaticResource Muted}"/>
              <StackPanel Grid.Column="1"><TextBlock Text="Wolverine V3 Pro" FontWeight="SemiBold"/><TextBlock x:Name="HintWolverine" Style="{StaticResource Hint}"/></StackPanel>
            </Grid>
            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Ellipse x:Name="DotSynapse" Width="11" Height="11" VerticalAlignment="Top" Margin="0,4,0,0" Fill="{StaticResource Muted}"/>
              <StackPanel Grid.Column="1"><TextBlock Text="Razer Synapse" FontWeight="SemiBold"/><TextBlock x:Name="HintSynapse" Style="{StaticResource Hint}"/></StackPanel>
            </Grid>
            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Ellipse x:Name="DotSdk" Width="11" Height="11" VerticalAlignment="Top" Margin="0,4,0,0" Fill="{StaticResource Muted}"/>
              <StackPanel Grid.Column="1"><TextBlock Text="Sensa SDK dosyaları" FontWeight="SemiBold"/><TextBlock x:Name="HintSdk" Style="{StaticResource Hint}"/></StackPanel>
            </Grid>
            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Ellipse x:Name="DotDualSense" Width="11" Height="11" VerticalAlignment="Top" Margin="0,4,0,0" Fill="{StaticResource Muted}"/>
              <StackPanel Grid.Column="1"><TextBlock Text="DualSense haptic kaynağı" FontWeight="SemiBold"/><TextBlock x:Name="HintDualSense" Style="{StaticResource Hint}"/></StackPanel>
            </Grid>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition/></Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorder}">
          <StackPanel>
            <TextBlock Text="Titreşim modu" Style="{StaticResource CardTitle}"/>
            <TextBlock Text="Bir mod seç; seçtiğin mod hemen ve her açılışta otomatik çalışır." Style="{StaticResource Hint}" Margin="0,0,0,14"/>
            <UniformGrid Columns="3">
              <RadioButton x:Name="ModeNormal" GroupName="Mode" Style="{StaticResource ChoiceCard}" Margin="0,0,10,0" Checked="Mode_Checked">
                <StackPanel>
                  <TextBlock Text="Normal" FontSize="15" FontWeight="SemiBold"/>
                  <TextBlock Text="Oyunun kendi titreşimi. Ek işlem yok." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="ModeAudio" GroupName="Mode" Style="{StaticResource ChoiceCard}" Margin="0,0,10,0" Checked="Mode_Checked">
                <StackPanel>
                  <TextBlock Text="Sesten titreşim" FontSize="15" FontWeight="SemiBold"/>
                  <TextBlock Text="Bilgisayar sesinden klasik titreşim üretir." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="ModeNative" GroupName="Mode" Style="{StaticResource ChoiceCard}" Checked="Mode_Checked">
                <StackPanel>
                  <TextBlock Text="Native DualSense" FontSize="15" FontWeight="SemiBold"/>
                  <TextBlock Text="4 kanal PCM'den deneysel, kayıplı Sensa dönüşümü." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                  <Border Background="#3A2A10" CornerRadius="6" Padding="6,1" Margin="0,8,0,0" HorizontalAlignment="Left">
                    <TextBlock Text="DENEYSEL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Warn}"/>
                  </Border>
                </StackPanel>
              </RadioButton>
            </UniformGrid>
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="StatusTitle" Text="Hazır" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusDetail" Style="{StaticResource Hint}" Margin="0,4,16,0" FontSize="13"/>
              </StackPanel>
            </Grid>

            <StackPanel x:Name="LevelPanel" Grid.Row="1" Margin="0,22,0,0" Visibility="Collapsed">
              <TextBlock Text="Gelen haptic sinyali" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
              <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock Text="Sol" Foreground="{StaticResource Muted}"/>
                <ProgressBar x:Name="LeftLevel" Grid.Column="1" Style="{StaticResource LevelBar}"/>
              </Grid>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock Text="Sağ" Foreground="{StaticResource Muted}"/>
                <ProgressBar x:Name="RightLevel" Grid.Column="1" Style="{StaticResource LevelBar}"/>
              </Grid>
            </StackPanel>

            <TextBlock x:Name="ModeNote" Grid.Row="3" Style="{StaticResource Hint}" FontSize="12"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- ===================== TEST ===================== -->
    <Grid x:Name="TestPage" Grid.Row="1" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition/></Grid.RowDefinitions>

      <!-- 1. Motor test -->
      <Border Grid.Column="0" Style="{StaticResource CardBorder}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="1 · Motor testi" Style="{StaticResource CardTitle}" VerticalAlignment="Top"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,28,0,0">
              <RadioButton x:Name="DevWolverine" Content="Wolverine" GroupName="TestDevice" Style="{StaticResource DeviceChip}"
                           IsChecked="True" Checked="TestDevice_Checked"/>
              <RadioButton x:Name="DevDualSense" Content="DualSense" GroupName="TestDevice" Style="{StaticResource DeviceChip}"
                           Checked="TestDevice_Checked"/>
              <RadioButton x:Name="DevXbox" Content="Xbox" GroupName="TestDevice" Style="{StaticResource DeviceChip}"
                           Checked="TestDevice_Checked"/>
            </StackPanel>
          </Grid>
          <TextBlock DockPanel.Dock="Top" Text="Aynı 3 vuruşluk desen seçili kolda / motorda çalar. DualSense referans, Xbox klasik titreşim." Style="{StaticResource Hint}" Margin="0,0,0,10"/>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="SensaLeftBtn" Content="◀  Sol" Style="{StaticResource Btn}" Click="SensaLeft_Click"/>
            <Button x:Name="SensaRightBtn" Content="Sağ  ▶" Style="{StaticResource Btn}" Click="SensaRight_Click"/>
            <Button x:Name="SensaBothBtn" Content="İkisi" Style="{StaticResource Btn}" Click="SensaBoth_Click"/>
            <Button x:Name="SensaResetBtn" Content="⟲  Sıfırla" Style="{StaticResource Btn}" Background="#4D3A1D"
                    ToolTip="Razer motorunu tamamen kapatıp temiz başlatır; takılan titreşimi keser." Click="SensaReset_Click"/>
          </StackPanel>
          <TextBlock DockPanel.Dock="Top" Text="Ses testleri: gerçek ses çalar, 'Sesten titreşim' yolu titreşime çevirir. Ön = keskin hızlı tıkırtı, arka = derin yumuşak uğultu." Style="{StaticResource Hint}" Margin="0,0,0,6"/>
          <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="AudioPanBtn" Content="🔊  Sol → sağ → sol" Tag="Glide" Style="{StaticResource Btn}" Background="#1D3A4D"
                    ToolTip="Sola-sağa-sola yavaşça kayan bas." Click="AudioPan_Click"/>
            <Button x:Name="AudioPingPongBtn" Content="🔊  En sol ↔ en sağ" Tag="PingPong" Style="{StaticResource Btn}" Background="#1D3A4D"
                    ToolTip="Native v2 'Sol ↔ Sağ' demosunun aynısı, ses olarak: 80 Hz, her tarafta 250 ms, 3 sn." Click="AudioPan_Click"/>
            <Button x:Name="AudioDir8Btn" Content="🔊  8 yön" Tag="Directions8" Style="{StaticResource Btn}" Background="#1D3A4D"
                    ToolTip="Ön, ön-sağ, sağ, arka-sağ, arka, arka-sol, sol, ön-sol." Click="AudioPan_Click"/>
            <Button x:Name="AudioFrontBackBtn" Content="🔊  Ön ↔ arka" Tag="FrontBack" Style="{StaticResource Btn}" Background="#1D3A4D"
                    ToolTip="Ön (keskin tıkırtı) ve arka (derin uğultu) sırayla, iki elde." Click="AudioPan_Click"/>
          </WrapPanel>
          <StackPanel x:Name="SensaAskPanel" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,8">
            <TextBlock x:Name="SensaAskText" Margin="0,0,0,6" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal">
              <Button Content="Sadece bu tarafta (A)" Style="{StaticResource SmallBtn}" Background="#1D4D38" Click="SensaFeltClean_Click"/>
              <Button Content="İki tarafta da (X)" Style="{StaticResource SmallBtn}" Background="#4D3A1D" Click="SensaFeltLeak_Click"/>
              <Button Content="Hissetmedim (B)" Style="{StaticResource SmallBtn}" Background="#4D1D24" Click="SensaFeltNo_Click"/>
            </StackPanel>
          </StackPanel>
          <StackPanel>
            <TextBlock x:Name="SensaWolverineResult" Foreground="{StaticResource Muted}"/>
            <TextBlock x:Name="SensaDualSenseResult" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
            <TextBlock x:Name="SensaTestStatus" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- 2. Native v2 demos -->
      <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardBorder}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
            <TextBlock Text="2 · Native v2 demolar" Style="{StaticResource CardTitle}" VerticalAlignment="Top"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,28,0,0">
              <RadioButton x:Name="DemoDevWolverine" Content="Wolverine" GroupName="DemoDevice" Style="{StaticResource DeviceChip}" IsChecked="True"/>
              <RadioButton x:Name="DemoDevDualSense" Content="DualSense" GroupName="DemoDevice" Style="{StaticResource DeviceChip}"/>
            </StackPanel>
          </Grid>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,12"
                     Text="Sentetik PCM demoları; özgün oyun kaydı değildir. Wolverine kayıplı v2, DualSense Exclusive referans. Ön/arka yalnız algısal kodlamadır."/>
          <ComboBox x:Name="DemoSceneCombo" DisplayMemberPath="Title" DockPanel.Dock="Top" MinHeight="32" Margin="0,0,0,8"/>
          <Button x:Name="DemoPlayBtn" Content="Seçili demoyu çal" DockPanel.Dock="Top" Style="{StaticResource SmallBtn}" HorizontalAlignment="Left" Click="DemoSelected_Click"/>
          <TextBlock x:Name="DemoStatus" DockPanel.Dock="Top" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,0"/>
          <TextBlock DockPanel.Dock="Top" Text="Oyun simülasyonu (sanal DualSense)" FontWeight="SemiBold" Foreground="#EEF3FF" Margin="0,12,0,2"/>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6"
                     Text="Sentetik oyun sinyalleri: 4 kanallı haptik PCM + DualSense tetik raporları birlikte gönderilir. İlk demo sol/sağ/çapraz testidir; aşamaya göre tetikleri sen çekersin. Xbox modu ve tetik motorları açık olmalı."/>
          <ComboBox x:Name="GameSimCombo" DisplayMemberPath="Title" DockPanel.Dock="Top" MinHeight="32" Margin="0,0,0,6" SelectionChanged="GameSimCombo_Changed"/>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <Button x:Name="GameSimBtn" Content="Oyun gibi çal" Style="{StaticResource SmallBtn}" Background="{StaticResource Accent}" Margin="0,0,6,0" Click="GameSim_Click"/>
            <Button x:Name="GameSimStopBtn" Content="■ Durdur" Style="{StaticResource SmallBtn}" Click="GameSimStop_Click"/>
          </StackPanel>
          <TextBlock x:Name="GameSimStatus" DockPanel.Dock="Top" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0"/>
          <TextBlock/>
        </DockPanel>
      </Border>
      <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource CardBorder}">
        <StackPanel>
          <TextBlock Text="3 · DualSense → W3 Pro • kanal laboratuvarı" Style="{StaticResource CardTitle}"/>
          <TextBlock Text="Aynı değişmez 4ch/48k PCM: kanal 3 sol, kanal 4 sağ. PCM tekrarı ayrıştırıcıyı, Windows uç nokta testi ayrı oynatıcı + gerçek WASAPI yakalamayı sınar. Oyun kaydı değildir." Style="{StaticResource Hint}" Margin="0,0,0,8"/>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="ChannelSceneCombo" DisplayMemberPath="Title" MinHeight="32"/>
            <ComboBox x:Name="ChannelMicCombo" Grid.Column="2" DisplayMemberPath="Name" MinHeight="32"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="ChannelMicEnabled" Foreground="#EEF3FF" Content="Mikrofonla ölç (yalnız düzey; ses kaydedilmez)" VerticalAlignment="Center"/>
          </StackPanel>
          <DockPanel Margin="0,0,0,8">
            <Button x:Name="ChannelRefreshEndpointsBtn" DockPanel.Dock="Right" Content="↻ Uç noktalar" Style="{StaticResource SmallBtn}" Click="ChannelRefreshEndpoints_Click"/>
            <Button x:Name="ChannelEndpointBtn" DockPanel.Dock="Right" Content="Windows uç noktası → W3" Style="{StaticResource SmallBtn}" Click="ChannelEndpoint_Click"
                    ToolTip="Açık Shared kaynak testi; source-only en çok 8 sn RAM karşılaştırması, sonra canlı Sensa. Kaydedilen ses dosyaya yazılmaz. Exclusive referans yolu değişmez."/>
            <ComboBox x:Name="ChannelEndpointCombo" DisplayMemberPath="Name" MinHeight="30"/>
          </DockPanel>
          <CheckBox x:Name="ChannelEndpointLevelEnabled" Foreground="#EEF3FF" Margin="0,0,0,8"
                    Content="Yalnız uç nokta testi boyunca Windows kaynağını aç / %100 yap; bitince önceki ayarı geri yükle"/>
          <WrapPanel Margin="0,0,0,8">
            <Button x:Name="ChannelReplayBtn" Content="W3 Pro • PCM dönüşümünü sına" Style="{StaticResource SmallBtn}" Click="ChannelReplay_Click"/>
            <Button x:Name="ChannelReferenceBtn" Content="DualSense • aynı PCM referansı" Style="{StaticResource SmallBtn}" Click="ChannelReference_Click"/>
            <Button x:Name="ChannelStopBtn" Content="■ Durdur (B)" Style="{StaticResource SmallBtn}" Click="ChannelStop_Click"/>
            <Button x:Name="ChannelReportBtn" Content="Son raporu aç" Style="{StaticResource SmallBtn}" IsEnabled="False" Click="ChannelReport_Click"/>
          </WrapPanel>
          <TextBlock x:Name="ChannelStatus" Text="Sol/sağ, farklı frekanslar, kısa vuruşlar ve hoparlör/sessizlik negatif kontrolleri. Mikrofon sesi fiziksel HD doğrulaması değildir." Style="{StaticResource Hint}"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ===================== AYARLAR ===================== -->
    <Grid x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>

      <Border Style="{StaticResource CardBorder}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
            <RadioButton x:Name="SettingsBasicTab" Content="Temel" GroupName="SettingsView" Style="{StaticResource PresetCard}" Width="96" IsChecked="True" Checked="SettingsView_Checked"/>
            <RadioButton x:Name="SettingsAdvancedTab" Content="Gelişmiş" GroupName="SettingsView" Style="{StaticResource PresetCard}" Width="96" Checked="SettingsView_Checked"/>
          </StackPanel>

          <!-- Temel -->
          <StackPanel x:Name="SettingsBasicPanel">
            <TextBlock Text="Titreşim gücü" Style="{StaticResource CardTitle}"/>
            <TextBlock Text="Bu uygulamanın gönderdiği titreşimler için. Oyunun kendi titreşimini değiştirmez." Style="{StaticResource Hint}" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
              <RadioButton x:Name="Level25" Content="%25" Tag="25" GroupName="Level" Style="{StaticResource PresetCard}" Checked="Level_Checked"/>
              <RadioButton x:Name="Level50" Content="%50" Tag="50" GroupName="Level" Style="{StaticResource PresetCard}" Checked="Level_Checked"/>
              <RadioButton x:Name="Level75" Content="%75" Tag="75" GroupName="Level" Style="{StaticResource PresetCard}" Checked="Level_Checked"/>
              <RadioButton x:Name="Level100" Content="%100" Tag="100" GroupName="Level" Style="{StaticResource PresetCard}" Checked="Level_Checked"/>
            </StackPanel>

            <TextBlock Text="Native güç (Wolverine)" Style="{StaticResource CardTitle}"/>
            <TextBlock Text="Zayıf sinyalleri güçlendirir; güçlü anlar yumuşak sınırlayıcıyla birbirinden ayrı kalır." Style="{StaticResource Hint}" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
              <RadioButton x:Name="GainNormal" Content="Normal" Tag="140" GroupName="NativeGain" Style="{StaticResource PresetCard}" Width="118" Checked="NativeGain_Checked"/>
              <RadioButton x:Name="GainStrong" Content="Güçlü" Tag="200" GroupName="NativeGain" Style="{StaticResource PresetCard}" Width="118" Checked="NativeGain_Checked"/>
              <RadioButton x:Name="GainMax" Content="Maksimum" Tag="300" GroupName="NativeGain" Style="{StaticResource PresetCard}" Width="118" Checked="NativeGain_Checked"/>
            </StackPanel>

            <TextBlock Text="Sesten titreşim hassasiyeti" Style="{StaticResource CardTitle}"/>
            <TextBlock Text="Oyun sesi oyundan oyuna farklı yüksekliktedir. Ses dalgası kırpılmaz; güçlü anlar sınırlayıcıyla korunur. Test sekmesindeki ses testlerini etkilemez." Style="{StaticResource Hint}" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
              <RadioButton x:Name="SensNormal" Content="Normal" Tag="100" GroupName="AudioSens" Style="{StaticResource PresetCard}" Width="118" Checked="AudioSensitivity_Checked"/>
              <RadioButton x:Name="SensHigh" Content="Yüksek" Tag="160" GroupName="AudioSens" Style="{StaticResource PresetCard}" Width="118" Checked="AudioSensitivity_Checked"/>
              <RadioButton x:Name="SensMax" Content="Çok yüksek" Tag="250" GroupName="AudioSens" Style="{StaticResource PresetCard}" Width="118" Checked="AudioSensitivity_Checked"/>
            </StackPanel>

            <TextBlock Text="Kontrolcü" Style="{StaticResource CardTitle}"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
              <TextBlock Text="Xbox kontrolcü yuvası:" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <ComboBox x:Name="DeviceSlotCombo" Width="170" SelectionChanged="DeviceSlot_Changed">
                <ComboBoxItem Content="Otomatik"/>
                <ComboBoxItem Content="Yuva 1"/>
                <ComboBoxItem Content="Yuva 2"/>
                <ComboBoxItem Content="Yuva 3"/>
                <ComboBoxItem Content="Yuva 4"/>
              </ComboBox>
            </StackPanel>
            <TextBlock Text="Kol modu" Style="{StaticResource CardTitle}" Margin="0,4,0,0"/>
            <TextBlock x:Name="PadModeText" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <WrapPanel Margin="0,0,0,8">
              <Button x:Name="PadModeXboxBtn" Content="Xbox moduna geç (tetik motorları)" Style="{StaticResource SmallBtn}" Margin="0,0,6,6" Click="PadModeXbox_Click"/>
              <Button Content="↻ Algıla" Style="{StaticResource SmallBtn}" Margin="0,0,6,6" Click="PadModeRefresh_Click"/>
            </WrapPanel>
            <TextBlock Text="DualSense tetik efektleri (Xbox modunda)" Foreground="#EEF3FF" Margin="0,0,0,4"/>
            <WrapPanel Margin="0,0,0,8">
              <RadioButton x:Name="TriggerFeelMotors" Content="Haptik + tetik motorları" Tag="1" GroupName="TriggerFeel" Style="{StaticResource PresetCard}" Width="190" Checked="TriggerFeel_Checked"
                           ToolTip="Yalnız Native DualSense: oyunun tetik kuvveti ve konumu tetik içi titreşime çevrilir; haptik sesi gövde motorlarında çalar. Fiziksel direnç üretmez. Ses modu yalnız gövde çıktısı üretir; oyunun tetik titreşimiyle eşzamanlı kullanım henüz doğrulanmadı."/>
              <RadioButton x:Name="TriggerFeelClassic" Content="Klasik (yalnız haptik)" Tag="0" GroupName="TriggerFeel" Style="{StaticResource PresetCard}" Width="170" Checked="TriggerFeel_Checked"
                           ToolTip="Tetik motorları kullanılmaz; tetik hissi de gövde titreşimiyle verilir (PC modundaki gibi)."/>
            </WrapPanel>
            <CheckBox x:Name="AutostartCheckbox" Content="Windows açılınca arka planda başlat" Foreground="#EEF3FF"
                      Checked="Autostart_Changed" Unchecked="Autostart_Changed"/>
          </StackPanel>

          <!-- Gelişmiş -->
          <StackPanel x:Name="SettingsAdvancedPanel" Visibility="Collapsed">
            <TextBlock Text="Wolverine çıkış yöntemi" Style="{StaticResource CardTitle}"/>
            <TextBlock Text="Standart: hızlı, keskin vuruşlar. Hibrit (deneysel): karışık sürekli seslerde doğru frekanslar. Çok bantlı (deneysel): kısa vuruşlar zayıflar."
                       Style="{StaticResource Hint}" Margin="0,0,0,10"/>
            <WrapPanel Margin="0,0,0,8">
              <RadioButton x:Name="MethodStandard" Content="Standart" Tag="0" GroupName="OutputMethod" Style="{StaticResource PresetCard}" Width="118" Checked="OutputMethod_Checked"/>
              <RadioButton x:Name="MethodHybrid" Content="Hibrit" Tag="2" GroupName="OutputMethod" Style="{StaticResource PresetCard}" Width="118" Checked="OutputMethod_Checked"/>
              <RadioButton x:Name="MethodMultiband" Content="Çok bantlı" Tag="1" GroupName="OutputMethod" Style="{StaticResource PresetCard}" Width="118" Checked="OutputMethod_Checked"/>
            </WrapPanel>
            <TextBlock x:Name="OutputMethodStatus" Style="{StaticResource Hint}" Margin="0,0,0,10"/>

            <TextBlock Text="Bağlantı yolu" Style="{StaticResource CardTitle}"/>
            <TextBlock Text="Doğrudan USB: Synapse ve Razer DLL'leri gerekmez (kol USB kablosuyla, PC modunda). Standart, Hibrit ve Çok bantlı çıkış desteklenir."
                       Style="{StaticResource Hint}" Margin="0,0,0,10"/>
            <WrapPanel Margin="0,0,0,6">
              <RadioButton x:Name="TransportSynapse" Content="Synapse" Tag="0" GroupName="Transport" Style="{StaticResource PresetCard}" Width="118" Checked="Transport_Checked"/>
              <RadioButton x:Name="TransportDirect" Content="Doğrudan USB" Tag="1" GroupName="Transport" Style="{StaticResource PresetCard}" Width="140" Checked="Transport_Checked"/>
            </WrapPanel>
            <TextBlock x:Name="TransportStatus" Style="{StaticResource Hint}" Margin="0,0,0,10" TextWrapping="Wrap"/>

            <TextBlock Text="Ses senkronu (Sesten titreşim)" Style="{StaticResource CardTitle}"/>
            <TextBlock Text="Bluetooth hoparlörde titreşimi sese göre geciktirir. Otomatik: Bluetooth 300 ms, kablolu 0." Style="{StaticResource Hint}" Margin="0,0,0,10"/>
            <WrapPanel Margin="0,0,0,8">
              <RadioButton x:Name="SyncAuto" Content="Otomatik" Tag="-1" GroupName="AudioSync" Style="{StaticResource PresetCard}" Width="118" Checked="AudioSync_Checked"/>
              <RadioButton x:Name="Sync0" Content="0 ms" Tag="0" GroupName="AudioSync" Style="{StaticResource PresetCard}" Width="92" Checked="AudioSync_Checked"/>
              <RadioButton x:Name="Sync150" Content="150 ms" Tag="150" GroupName="AudioSync" Style="{StaticResource PresetCard}" Width="92" Checked="AudioSync_Checked"/>
              <RadioButton x:Name="Sync300" Content="300 ms" Tag="300" GroupName="AudioSync" Style="{StaticResource PresetCard}" Width="92" Checked="AudioSync_Checked"/>
              <RadioButton x:Name="Sync450" Content="450 ms" Tag="450" GroupName="AudioSync" Style="{StaticResource PresetCard}" Width="92" Checked="AudioSync_Checked"/>
            </WrapPanel>
            <TextBlock x:Name="AudioSyncStatus" Style="{StaticResource Hint}"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition/></Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorder}">
          <StackPanel>
            <Grid>
              <TextBlock Text="Güncellemeler" Style="{StaticResource CardTitle}"/>
              <TextBlock x:Name="VersionText" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/>
            </Grid>
            <TextBlock x:Name="UpdateStatusText" Text="Henüz kontrol edilmedi." Style="{StaticResource Hint}" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal">
              <Button Content="Kontrol et" Style="{StaticResource SmallBtn}" Click="CheckUpdate_Click"/>
              <Button x:Name="DownloadUpdateButton" Content="İndir ve kur" Style="{StaticResource SmallBtn}" Background="{StaticResource Accent}" Visibility="Collapsed" Click="DownloadUpdate_Click"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
          <StackPanel>
            <TextBlock Text="Sorun giderme" Style="{StaticResource CardTitle}"/>
            <TextBlock x:Name="ResourceText" Style="{StaticResource Hint}"/>
            <TextBlock x:Name="DiagnosticsText" Text="Son hata: yok" Style="{StaticResource Hint}" Margin="0,2,0,10"/>
            <WrapPanel>
              <Button Content="Durum raporunu kopyala" Style="{StaticResource SmallBtn}" Margin="0,0,6,6" Click="CopyStatus_Click"/>
              <Button Content="Günlüğü aç" Style="{StaticResource SmallBtn}" Margin="0,0,6,6" Click="OpenLog_Click"/>
              <Button Content="Razer Synapse" Style="{StaticResource SmallBtn}" Margin="0,0,6,6" Click="Synapse_Click"/>
              <Button Content="GitHub" Style="{StaticResource SmallBtn}" Margin="0,0,6,6" Click="Github_Click"/>
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardBorder}">
          <StackPanel>
            <Grid>
              <TextBlock Text="Sanal DualSense (HIDMaestro)" Style="{StaticResource CardTitle}"/>
              <Border x:Name="VcBadge" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="8" Padding="8,2" Background="#1A2740">
                <TextBlock x:Name="VcBadgeText" Text="…" FontSize="12" Foreground="#EEF3FF"/>
              </Border>
            </Grid>
            <TextBlock Text="Oyun gerçek bir DualSense görür (titreşim sesi + tetikler); fiziksel DualSense gerekmez. Yönetici izni ister." Style="{StaticResource Hint}" Margin="0,0,0,8"/>
            <TextBlock x:Name="VcDriverText" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
            <TextBlock x:Name="VcSelfTestText" Style="{StaticResource Hint}" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <WrapPanel>
              <Button x:Name="VcInstallBtn" Content="Kur" Style="{StaticResource SmallBtn}" Background="{StaticResource Accent}" Margin="0,0,6,6" Click="VcInstall_Click"/>
              <Button x:Name="VcTestBtn" Content="Sağlık testi" Style="{StaticResource SmallBtn}" Margin="0,0,6,6" Click="VcSelfTest_Click"/>
              <Button x:Name="VcUninstallBtn" Content="Kaldır" Style="{StaticResource SmallBtn}" Margin="0,0,6,6" Click="VcUninstall_Click"/>
            </WrapPanel>
            <TextBlock x:Name="HhText" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,2"/>
            <WrapPanel>
              <CheckBox x:Name="HhHideCheckbox" Content="Köprü açıkken Xbox kolunu oyundan gizle (çift giriş olmaz)" Foreground="#EEF3FF"
                        VerticalAlignment="Center" Margin="0,0,8,6" Checked="HhHide_Changed" Unchecked="HhHide_Changed"/>
              <Button x:Name="HhInstallBtn" Content="HidHide indir" Style="{StaticResource SmallBtn}" Margin="0,0,6,6" Click="HhInstall_Click" Visibility="Collapsed"/>
              <Button x:Name="HhRestoreBtn" Content="Gizlemeyi geri al" Style="{StaticResource SmallBtn}" Margin="0,0,6,6" Click="HhRestore_Click" Visibility="Collapsed"/>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <Button x:Name="VcBridgeBtn" Content="Köprüyü başlat" Style="{StaticResource SmallBtn}" Background="{StaticResource Accent}" Margin="0,0,10,0" Click="VcBridge_Click"/>
              <TextBlock x:Name="VcBridgeText" Style="{StaticResource Hint}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- FOOTER -->
    <Grid Grid.Row="2" Margin="2,14,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Style="{StaticResource Hint}" FontSize="11.5" Margin="0,0,16,0"
                 Text="Native mod deneyseldir: Wolverine'e kayıplı Sensa parametreleri gider; özgün dalga biçimi ve faz korunmaz. Veriler yalnızca bu bilgisayarda tutulur."/>
      <Border Grid.Column="1" Background="#121C31" CornerRadius="8" Padding="10,5">
        <TextBlock FontSize="11.5" Foreground="#C9D6F0"
                   Text="🎮  LB/RB sekme · D-pad gezin · A seç · B geri · ☰ mod değiştir"/>
      </Border>
    </Grid>
  </Grid>
</Window>
