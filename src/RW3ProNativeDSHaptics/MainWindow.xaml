            </StackPanel>
          </Grid>
          <TextBlock DockPanel.Dock="Top" Text="Kol titriyor mu? Sol, sağ ya da ikisi: 3 kısa vuruş çalar. Titreşim takılı kalırsa Sıfırla." Style="{StaticResource Hint}" Margin="0,0,0,10"/>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
