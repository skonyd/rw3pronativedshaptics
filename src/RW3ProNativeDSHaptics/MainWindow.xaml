              </Border>
            </Grid>
            <TextBlock Text="Oyun gerçek bir DualSense görür (titreşim sesi + tetikler); fiziksel DualSense gerekmez. Yönetici izni ister." Style="{StaticResource Hint}" Margin="0,0,0,8"/>
            <TextBlock x:Name="VcDriverText" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
            <TextBlock x:Name="VcSelfTestText" Style="{StaticResource Hint}" Margin="0,0,0,4" TextWrapping="Wrap"/>
            <DockPanel Margin="0,0,0,6">
              <Button x:Name="VcTaskBtn" DockPanel.Dock="Right" Content="Etkinleştir" Style="{StaticResource SmallBtn}" Click="VcTask_Click"
                      ToolTip="Bir kez yönetici izni ister; sonra köprü UAC sormadan başlar (Windows zamanlanmış görevi)."/>
              <TextBlock x:Name="VcTaskText" Style="{StaticResource Hint}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
            </DockPanel>
            <WrapPanel>
              <Button x:Name="VcInstallBtn" Content="Kur" Style="{StaticResource SmallBtn}" Background="{StaticResource Accent}" Margin="0,0,6,6" Click="VcInstall_Click"/>
              <Button x:Name="VcTestBtn" Content="Sağlık testi" Style="{StaticResource SmallBtn}" Margin="0,0,6,6" Click="VcSelfTest_Click"/>
              <Button x:Name="VcUninstallBtn" Content="Kaldır" Style="{StaticResource SmallBtn}" Margin="0,0,6,6" Click="VcUninstall_Click"/>
            </WrapPanel>
            <TextBlock x:Name="HhText" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,2"/>
            <WrapPanel>
              <CheckBox x:Name="HhHideCheckbox" Content="Köprü açıkken Xbox kolunu oyundan gizle (çift giriş olmaz)" Foreground="#EEF3FF"
                        VerticalAlignment="Center" Margin="0,0,8,6" Checked="HhHide_Changed" Unchecked="HhHide_Changed"/>
              <Button x:Name="HhInstallBtn" Content="HidHide indir" Style="{StaticResource SmallBtn}" Margin="0,0,6,6" Click="HhInstall_Click" Visibility="Collapsed"/>
              <Button x:Name="HhRestoreBtn" Content="Gizlemeyi geri al" Style="{StaticResource SmallBtn}" Margin="0,0,6,6" Click="HhRestore_Click" Visibility="Collapsed"/>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <TextBlock Text="Köprü, Genel → 'DualSense oyunları' seçilince kendiliğinden açılır." Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0" TextWrapping="Wrap" MaxWidth="220"/>
              <TextBlock x:Name="VcBridgeText" Style="{StaticResource Hint}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- FOOTER -->
    <Grid Grid.Row="2" Margin="2,14,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Style="{StaticResource Hint}" FontSize="11.5" Margin="0,0,16,0"
                 Text="Native mod deneyseldir: Wolverine'e kayıplı Sensa parametreleri gider; özgün dalga biçimi ve faz korunmaz. Veriler yalnızca bu bilgisayarda tutulur."/>
      <Border Grid.Column="1" Background="#121C31" CornerRadius="8" Padding="10,5">
        <TextBlock FontSize="11.5" Foreground="#C9D6F0"
                   Text="🎮  LB/RB sekme · D-pad gezin · A seç · B geri · ☰ mod değiştir"/>
      </Border>
    </Grid>

    <!-- GENERAL CALIBRATION (blind, controller-driven) -->
    <Grid x:Name="CalibPanel" Grid.RowSpan="3" Visibility="Collapsed" Background="#F70B1322" Panel.ZIndex="50" Margin="-28,-20,-28,-22">
      <DockPanel Margin="48,36,48,30">
        <TextBlock x:Name="CalibHint" DockPanel.Dock="Bottom" FontSize="15" Foreground="#9FB3D9" Margin="0,16,0,0"
                   Text="Ⓧ Ⓐ Ⓑ Ⓨ seç · ⧉ tekrar çal · ☰ testi bitir   (klavye: 1 2 3 4 · R · Esc)"/>
        <TextBlock x:Name="CalibProgress" DockPanel.Dock="Top" FontSize="17" Foreground="#9FB3D9"/>
        <TextBlock x:Name="CalibQuestion" DockPanel.Dock="Top" FontSize="36" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" Margin="0,14,0,28"/>
        <UniformGrid x:Name="CalibOptions" DockPanel.Dock="Top" Rows="1" Columns="4" Visibility="Hidden">
          <Button x:Name="CalibOpt0" Tag="0" Click="CalibOption_Click" Margin="0,0,12,0" MinHeight="120" Background="#22477F" BorderThickness="0" Foreground="White" Focusable="False">
            <StackPanel><TextBlock Text="Ⓧ" FontSize="30" HorizontalAlignment="Center" Foreground="#7FB2FF"/><TextBlock x:Name="CalibOptText0" FontSize="22" TextWrapping="Wrap" TextAlignment="Center" Margin="10,6"/></StackPanel>
          </Button>
          <Button x:Name="CalibOpt1" Tag="1" Click="CalibOption_Click" Margin="6,0" MinHeight="120" Background="#1E5A3A" BorderThickness="0" Foreground="White" Focusable="False">
            <StackPanel><TextBlock Text="Ⓐ" FontSize="30" HorizontalAlignment="Center" Foreground="#7FE0A6"/><TextBlock x:Name="CalibOptText1" FontSize="22" TextWrapping="Wrap" TextAlignment="Center" Margin="10,6"/></StackPanel>
          </Button>
          <Button x:Name="CalibOpt2" Tag="2" Click="CalibOption_Click" Margin="6,0" MinHeight="120" Background="#6A2424" BorderThickness="0" Foreground="White" Focusable="False">
            <StackPanel><TextBlock Text="Ⓑ" FontSize="30" HorizontalAlignment="Center" Foreground="#FF9C93"/><TextBlock x:Name="CalibOptText2" FontSize="22" TextWrapping="Wrap" TextAlignment="Center" Margin="10,6"/></StackPanel>
          </Button>
          <Button x:Name="CalibOpt3" Tag="3" Click="CalibOption_Click" Margin="12,0,0,0" MinHeight="120" Background="#5E5420" BorderThickness="0" Foreground="White" Focusable="False">
            <StackPanel><TextBlock Text="Ⓨ" FontSize="30" HorizontalAlignment="Center" Foreground="#FFE37F"/><TextBlock x:Name="CalibOptText3" FontSize="22" TextWrapping="Wrap" TextAlignment="Center" Margin="10,6"/></StackPanel>
          </Button>
        </UniformGrid>
        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
          <TextBlock x:Name="CalibSummary" FontFamily="Consolas" FontSize="14" Foreground="#DDE6F7" TextWrapping="Wrap"/>
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
