                    ToolTip="Razer motorunu tamamen kapatıp temiz başlatır; takılan titreşimi keser." Click="SensaReset_Click"/>
          </StackPanel>
          <TextBlock DockPanel.Dock="Top" Text="Kalibrasyon: kolu eline al, titreşimin nereden geldiğini kumandayla seç (Ⓧ Ⓐ Ⓑ Ⓨ, ⧉ tekrar, ☰ bitir). Yaklaşık 6 dakika; sonuç kaydedilir." Style="{StaticResource Hint}" Margin="0,0,0,6" TextWrapping="Wrap"/>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
            <Button x:Name="CalibBtn" Content="🎯  Genel kalibrasyon testi" Style="{StaticResource Btn}" Background="{StaticResource Accent}" Click="Calibration_Click"
                    AutomationProperties.Name="Genel kalibrasyon testi"/>
            <Button x:Name="CalibFolderBtn" Content="Sonuç klasörü" Style="{StaticResource SmallBtn}" Click="CalibrationFolder_Click"/>
          </StackPanel>
          <TextBlock x:Name="CalibStatus" DockPanel.Dock="Top" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <TextBlock DockPanel.Dock="Top" Text="Ses testleri: gerçek ses çalar, 'Sesten titreşim' yolu titreşime çevirir. Ön = keskin hızlı tıkırtı, arka = derin yumuşak uğultu." Style="{StaticResource Hint}" Margin="0,0,0,6"/>
          <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="AudioPanBtn" Content="🔊  Sol → sağ → sol" Tag="Glide" Style="{StaticResource Btn}" Background="#1D3A4D"
                    ToolTip="Sola-sağa-sola yavaşça kayan bas." Click="AudioPan_Click"/>
            <Button x:Name="AudioPingPongBtn" Content="🔊  En sol ↔ en sağ" Tag="PingPong" Style="{StaticResource Btn}" Background="#1D3A4D"
