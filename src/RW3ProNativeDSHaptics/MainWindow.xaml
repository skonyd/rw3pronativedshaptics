      <!-- Right: Create Custom Shortcut + Saved Shortcuts / Onboard Hardware Reference -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition/></Grid.RowDefinitions>

        <!-- Top Card: Create New Custom Shortcut -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="16,13">
          <StackPanel>
            <DockPanel Margin="0,0,0,6">
              <TextBlock DockPanel.Dock="Right" x:Name="ShortcutStatusText" Text="Hazır" FontSize="11.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
              <TextBlock Text="Yeni Kısayol Ekle" Style="{StaticResource CardTitle}" Margin="0"/>
            </DockPanel>

            <Grid Margin="0,2,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="ShortcutKindPad" Content="🎮 Kol" GroupName="ShortcutKind" Style="{StaticResource DeviceChip}" IsChecked="True" Checked="ShortcutKind_Changed"/>
                <RadioButton x:Name="ShortcutKindKey" Content="⌨ Tuş" GroupName="ShortcutKind" Style="{StaticResource DeviceChip}" Checked="ShortcutKind_Changed"/>
              </StackPanel>
              <Border Grid.Column="2" Background="#0B1222" CornerRadius="8" Padding="10,5" BorderBrush="{StaticResource Line}" BorderThickness="1" VerticalAlignment="Center">
                <TextBlock x:Name="ShortcutCapturedText" Text="⧉ View + D-Pad ↑" FontWeight="SemiBold" FontSize="12.5" Foreground="#6CA6FF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </Border>
              <Button Grid.Column="3" x:Name="ShortcutCaptureBtn" Content="🎯 Dinle" Style="{StaticResource SmallBtn}" Background="{StaticResource Accent}" Margin="6,0,0,0"
                      Click="ShortcutCapture_Click"/>
            </Grid>

            <Grid x:Name="ShortcutHoldRow" Margin="0,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="ShortcutHold0" Content="Anında" Tag="0" GroupName="ShortcutHold" Style="{StaticResource DeviceChip}" IsChecked="True" Checked="ShortcutHold_Changed"/>
                <RadioButton x:Name="ShortcutHold400" Content="0.4 sn" Tag="400" GroupName="ShortcutHold" Style="{StaticResource DeviceChip}" Checked="ShortcutHold_Changed"/>
                <RadioButton x:Name="ShortcutHold800" Content="0.8 sn" Tag="800" GroupName="ShortcutHold" Style="{StaticResource DeviceChip}" Checked="ShortcutHold_Changed"/>
              </StackPanel>
              <CheckBox Grid.Column="1" x:Name="ShortcutsBackgroundCheck" Content="Her yerde çalışsın" Foreground="#CBD8F0" FontSize="11.5"
                        HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="True" Checked="ShortcutsBackground_Changed" Unchecked="ShortcutsBackground_Changed"/>
            </Grid>

            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ComboBox x:Name="ShortcutActionCombo" MinHeight="30" DisplayMemberPath="Label" SelectedValuePath="Action"/>
              <Button Grid.Column="1" x:Name="ShortcutAddBtn" Content="＋ Ekle" Style="{StaticResource SmallBtn}" Background="#1D4D38" Margin="8,0,0,0"
                      Click="ShortcutAdd_Click"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Bottom Card: Toggle between My Custom Shortcuts and Onboard Hardware Shortcuts -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="16,13">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
              <Button DockPanel.Dock="Right" Content="↺ Varsayılanlar" Style="{StaticResource SmallBtn}" Click="ShortcutsRestoreDefaults_Click"
                      ToolTip="Varsayılan özel kısayolları geri yükle"/>
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="SubTabUserShortcuts" Content="Özel Kısayollarım" GroupName="ShortcutSubTab" Style="{StaticResource DeviceChip}" IsChecked="True" Checked="ShortcutSubTab_Checked"/>
                <RadioButton x:Name="SubTabHardwareShortcuts" Content="Kolun Hazır Kısayolları" GroupName="ShortcutSubTab" Style="{StaticResource DeviceChip}" Checked="ShortcutSubTab_Checked"/>
              </StackPanel>
            </DockPanel>

            <!-- Custom Shortcuts List -->
            <ScrollViewer x:Name="UserShortcutsPanel" VerticalScrollBarVisibility="Auto" Focusable="False">
              <ItemsControl x:Name="UserShortcutsList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#0F1829" CornerRadius="9" Padding="10,8" Margin="0,0,4,7" BorderBrush="{StaticResource Line}" BorderThickness="1">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding Enabled}" Tag="{Binding Id}" VerticalAlignment="Center" Margin="0,0,8,0"
                                  Checked="UserShortcutEnabled_Changed" Unchecked="UserShortcutEnabled_Changed"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <WrapPanel VerticalAlignment="Center">
                            <Border Background="#16233D" CornerRadius="5" Padding="5,1" Margin="0,0,5,0">
                              <TextBlock Text="{Binding KindBadge}" FontSize="10.5" Foreground="#9FB3D9"/>
                            </Border>
                            <Border Background="#1E3563" CornerRadius="5" Padding="7,1">
                              <TextBlock Text="{Binding TriggerDisplay}" FontWeight="Bold" FontSize="11.5" Foreground="#FFFFFF"/>
                            </Border>
                          </WrapPanel>
                          <TextBlock Text="{Binding ActionDisplay}" FontWeight="SemiBold" FontSize="12" Foreground="#EEF3FF" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="▶" Tag="{Binding Id}" Style="{StaticResource SmallBtn}" Margin="6,0,4,0" VerticalAlignment="Center"
                                ToolTip="Şimdi dene" Click="UserShortcutTest_Click"/>
                        <Button Grid.Column="3" Content="✕" Tag="{Binding Id}" Style="{StaticResource SmallBtn}" Background="#4D1D24" VerticalAlignment="Center"
                                ToolTip="Sil" Click="UserShortcutDelete_Click"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- Onboard Hardware Shortcuts Reference -->
            <ScrollViewer x:Name="HardwareShortcutsPanel" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Collapsed">
              <ItemsControl x:Name="BuiltInShortcutsList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#0F1829" CornerRadius="9" Padding="10,8" Margin="0,0,4,7" BorderBrush="{StaticResource Line}" BorderThickness="1">
                      <StackPanel>
                        <DockPanel>
                          <Border DockPanel.Dock="Right" Background="#17284A" CornerRadius="5" Padding="7,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Combo}" FontWeight="Bold" FontSize="11" Foreground="#6CA6FF"/>
                          </Border>
                          <TextBlock Text="{Binding Category}" FontSize="10.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="#EEF3FF" TextWrapping="Wrap" Margin="0,4,0,0"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- ===================== TEST ===================== -->
    <Grid x:Name="TestPage" Grid.Row="1" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition/></Grid.RowDefinitions>

      <!-- 1. Motor test -->
      <Border Grid.Column="0" Style="{StaticResource CardBorder}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="1 · Motor testi" Style="{StaticResource CardTitle}" VerticalAlignment="Top"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,28,0,0">
              <RadioButton x:Name="DevWolverine" Content="Wolverine" GroupName="TestDevice" Style="{StaticResource DeviceChip}"
