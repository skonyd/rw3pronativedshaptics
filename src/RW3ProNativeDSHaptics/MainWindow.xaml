<Window x:Class="RW3ProNativeDSHaptics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RW3 Pro Haptics"
        Icon="Assets/App.ico"
        Width="1000" Height="800" MinWidth="960" MinHeight="780"
        Background="#0B1222" Foreground="#EEF3FF" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded"
        Closing="Window_Closing" StateChanged="Window_StateChanged">
  <Window.Resources>
    <SolidColorBrush x:Key="Card" Color="#121C31"/>
    <SolidColorBrush x:Key="CardHover" Color="#18243D"/>
    <SolidColorBrush x:Key="Line" Color="#22304D"/>
    <SolidColorBrush x:Key="Muted" Color="#93A2BF"/>
    <SolidColorBrush x:Key="Accent" Color="#3D7BFF"/>
    <SolidColorBrush x:Key="Good" Color="#3DD68C"/>
    <SolidColorBrush x:Key="Bad" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="Warn" Color="#FFB547"/>

    <Style x:Key="CardBorder" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Card}"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="20,18"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Background" Value="#22304D"/>
      <Setter Property="Foreground" Value="#EEF3FF"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"
                  BorderBrush="Transparent" BorderThickness="2">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#FFFFFF"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.85"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.35"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Padding" Value="26,13"/>
    </Style>
    <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Padding" Value="11,6"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <!-- Top navigation tabs -->
    <Style x:Key="TabButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="4,0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="RadioButton">
          <Border x:Name="B" Background="Transparent" CornerRadius="9" Padding="16,7" BorderBrush="Transparent" BorderThickness="2">
            <ContentPresenter HorizontalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#16213A"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="B" Property="Background" Value="#22304D"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#FFFFFF"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>

    <!-- Selectable cards (modes, intensity presets) -->
    <Style x:Key="ChoiceCard" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#EEF3FF"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="RadioButton">
          <Border x:Name="B" Background="#0F1829" BorderBrush="{StaticResource Line}" BorderThickness="2"
                  CornerRadius="12" Padding="16,14">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#16213A"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}"/>
              <Setter TargetName="B" Property="Background" Value="#172443"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#FFFFFF"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PresetCard" TargetType="RadioButton" BasedOn="{StaticResource ChoiceCard}">
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Width" Value="78"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DeviceChip" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#C9D6F0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="RadioButton">
          <Border x:Name="B" Background="#0F1829" BorderBrush="{StaticResource Line}" BorderThickness="2" CornerRadius="8" Padding="12,4">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}"/>
              <Setter TargetName="B" Property="Background" Value="#172443"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#FFFFFF"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LevelBar" TargetType="ProgressBar">
      <Setter Property="Height" Value="8"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="Background" Value="#0B1222"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
  </Window.Resources>

  <Grid Margin="28,20,28,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- HEADER + TABS -->
    <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="RW3 Pro Haptics" FontSize="22" FontWeight="Bold"/>
        <TextBlock Text="Wolverine V3 Pro • DualSense haptics" Style="{StaticResource Hint}"/>
      </StackPanel>
      <Border Grid.Column="1" HorizontalAlignment="Center" Background="#101A2E" CornerRadius="12" Padding="5">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="TabGeneral" Content="Genel kullanım" GroupName="Tabs" Style="{StaticResource TabButton}" IsChecked="True" Checked="Tab_Checked"/>
          <RadioButton x:Name="TabTest" Content="Test" GroupName="Tabs" Style="{StaticResource TabButton}" Checked="Tab_Checked"/>
          <RadioButton x:Name="TabSettings" Content="Ayarlar" GroupName="Tabs" Style="{StaticResource TabButton}" Checked="Tab_Checked"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" x:Name="RunBadge" Background="#1A2740" CornerRadius="20" Padding="14,7" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="RunBadgeDot" Width="9" Height="9" Fill="{StaticResource Muted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="RunBadgeText" Text="Kapalı" FontWeight="SemiBold"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ===================== GENEL KULLANIM ===================== -->
    <Grid x:Name="GeneralPage" Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>

      <Border Style="{StaticResource CardBorder}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Bağlantılar" Style="{StaticResource CardTitle}"/>
          <TextBlock DockPanel.Dock="Top" Text="Kolun ve gereken parçaların durumu." Style="{StaticResource Hint}" Margin="0,0,0,14"/>
          <Button DockPanel.Dock="Bottom" Content="↻  Yeniden kontrol et" Style="{StaticResource SmallBtn}" HorizontalAlignment="Left" Click="RefreshChecks_Click"/>
          <StackPanel x:Name="CheckList">
            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Ellipse x:Name="DotWolverine" Width="11" Height="11" VerticalAlignment="Top" Margin="0,4,0,0" Fill="{StaticResource Muted}"/>
              <StackPanel Grid.Column="1"><TextBlock Text="Wolverine V3 Pro" FontWeight="SemiBold"/><TextBlock x:Name="HintWolverine" Style="{StaticResource Hint}"/></StackPanel>
            </Grid>
            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Ellipse x:Name="DotSynapse" Width="11" Height="11" VerticalAlignment="Top" Margin="0,4,0,0" Fill="{StaticResource Muted}"/>
              <StackPanel Grid.Column="1"><TextBlock Text="Avuç haptiği (Sensa)" FontWeight="SemiBold"/><TextBlock x:Name="HintSynapse" Style="{StaticResource Hint}"/></StackPanel>
            </Grid>
            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Ellipse x:Name="DotSdk" Width="11" Height="11" VerticalAlignment="Top" Margin="0,4,0,0" Fill="{StaticResource Muted}"/>
              <StackPanel Grid.Column="1"><TextBlock Text="Sanal DualSense sürücüsü" FontWeight="SemiBold"/><TextBlock x:Name="HintSdk" Style="{StaticResource Hint}"/></StackPanel>
            </Grid>
            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Ellipse x:Name="DotDualSense" Width="11" Height="11" VerticalAlignment="Top" Margin="0,4,0,0" Fill="{StaticResource Muted}"/>
              <StackPanel Grid.Column="1"><TextBlock Text="DualSense köprüsü" FontWeight="SemiBold"/><TextBlock x:Name="HintDualSense" Style="{StaticResource Hint}"/></StackPanel>
            </Grid>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition/></Grid.RowDefinitions>

        <!-- what is running right now: always visible above the options -->
        <Border Style="{StaticResource CardBorder}" Padding="20,14">
          <StackPanel>
            <TextBlock x:Name="StatusTitle" Text="Hazır" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="StatusDetail" Style="{StaticResource Hint}" Margin="0,3,0,0" FontSize="12.5"/>
            <Grid x:Name="LevelPanel" Margin="0,10,0,0" Visibility="Collapsed">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Text="Sol" Foreground="{StaticResource Muted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <ProgressBar x:Name="LeftLevel" Grid.Column="1" Style="{StaticResource LevelBar}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="3" Text="Sağ" Foreground="{StaticResource Muted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <ProgressBar x:Name="RightLevel" Grid.Column="4" Style="{StaticResource LevelBar}" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="ModeNote" Style="{StaticResource Hint}" FontSize="12" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Titreşim modu" Style="{StaticResource CardTitle}"/>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,12"
                       Text="Seçtiğin mod hemen ve her açılışta kendiliğinden çalışır. Kumandada ☰ ile de değişir."/>
            <UniformGrid DockPanel.Dock="Top" Columns="3">
              <RadioButton x:Name="ModeNormal" GroupName="Mode" Style="{StaticResource ChoiceCard}" Margin="0,0,10,0" Checked="Mode_Checked">
                <StackPanel>
                  <TextBlock Text="Normal" FontSize="15" FontWeight="SemiBold"/>
                  <TextBlock Text="Uygulama karışmaz. Oyunun Xbox titreşimi olduğu gibi kola gider." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="ModeAudio" GroupName="Mode" Style="{StaticResource ChoiceCard}" Margin="0,0,10,0" Checked="Mode_Checked">
                <StackPanel>
                  <TextBlock Text="Sesten titreşim" FontSize="15" FontWeight="SemiBold"/>
                  <TextBlock Text="Her oyunda, filmde, müzikte. Bilgisayarın sesi avuçlarda titreşir." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="ModeNative" GroupName="Mode" Style="{StaticResource ChoiceCard}" Checked="Mode_Checked">
                <StackPanel>
                  <TextBlock Text="DualSense oyunları" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="Oyun kolu DualSense sanır: tetik efektleri, HD haptik ya da sesten haptik." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                  <Border Background="#3A2A10" CornerRadius="6" Padding="6,1" Margin="0,6,0,0" HorizontalAlignment="Left">
                    <TextBlock Text="BETA" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Warn}"/>
                  </Border>
                </StackPanel>
              </RadioButton>
            </UniformGrid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0" Focusable="False">
            <StackPanel Margin="0,0,10,0">
            <StackPanel x:Name="NormalSourceRows" Visibility="Collapsed">
              <TextBlock Text="Xbox kolu destekleyen oyunlarda seç. Wolverine Xbox modundayken standart gövde titreşimi ve oyun gönderiyorsa tetik içi titreşim doğrudan kola gider." Style="{StaticResource Hint}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel x:Name="AudioSourceRows" Visibility="Collapsed">
              <TextBlock Text="Bilgisayarın sesi titreşime çevrilir: PC modunda ve Xbox modunda avuçlar (Sensa), Sensa kapalıysa gövde motorları." Style="{StaticResource Hint}"/>
              <!-- level (shared with the native mode's sound source) -->
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
                <TextBlock Text="Titreşim seviyesi" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Slider x:Name="AudioLevelSlider" Grid.Column="1" Minimum="10" Maximum="300" SmallChange="5" LargeChange="25" TickFrequency="5"
                        IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="AudioLevel_Changed" AutomationProperties.Name="Sesten titreşim seviyesi"/>
                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=AudioLevelSlider, StringFormat='%{0:0}'}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock Text="%100 = sesin kendi seviyesi. Hemen uygulanır." Style="{StaticResource Hint}"/>
              <CheckBox x:Name="AudioStandard" Content="Standart (DSX gibi): ses olduğu gibi, sessizlikte durur" Foreground="#EEF3FF" Margin="0,8,0,0"
                        Checked="AudioShaping_Changed" Unchecked="AudioShaping_Changed"/>
              <TextBlock Text="Önerilen. Kısık ses zayıf, yüksek ses güçlü titreşir; çok sessiz kısımlarda titreşim tamamen kesilir." Style="{StaticResource Hint}"/>

              <!-- the game's own Xbox feedback, merged through a virtual Xbox pad -->
              <TextBlock Text="Oyunun kendi titreşimini de ekle (Xbox modu)" FontWeight="SemiBold" Margin="0,12,0,2"/>
              <CheckBox x:Name="IncludeXboxGameRumble" Content="Oyunun gövde titreşimi (rumble)" Foreground="#EEF3FF"
                        Checked="CombineXboxFeedback_Changed" Unchecked="CombineXboxFeedback_Changed"/>
              <CheckBox x:Name="IncludeXboxGameTriggers" Content="Oyunun LT/RT tetik titreşimi" Foreground="#EEF3FF"
                        Checked="CombineXboxFeedback_Changed" Unchecked="CombineXboxFeedback_Changed"/>
              <TextBlock Text="Kol Xbox modunda olmalı. Sanal Xbox kolu (HIDMaestro + HidHide) kurulur, fiziksel kol oyundan gizlenir; oyunu bundan sonra aç. Bu yolda ses gövde motorlarına gider." Style="{StaticResource Hint}"/>

              <Expander Header="Gelişmiş ses ayarları" Foreground="#EEF3FF" Margin="0,12,0,0">
                <StackPanel Margin="4,6,0,0">
                  <TextBlock Text="Frekans filtresi" FontWeight="SemiBold" Margin="0,0,0,2"/>
                  <RadioButton x:Name="AudioProfileExisting" GroupName="AudioProfile" Tag="Existing" Content="Tam haptik bant (önerilen)" Foreground="#EEF3FF" Checked="AudioProfile_Checked"/>
                  <RadioButton x:Name="AudioProfileControlled" GroupName="AudioProfile" Tag="Controlled" Content="Derin bas (30–130 Hz)" Foreground="#EEF3FF" Checked="AudioProfile_Checked"/>
                  <RadioButton x:Name="AudioProfileBalanced" GroupName="AudioProfile" Tag="Balanced" Content="Bas (30–150 Hz)" Foreground="#EEF3FF" Checked="AudioProfile_Checked"/>
                  <RadioButton x:Name="AudioProfileDynamic" GroupName="AudioProfile" Tag="Dynamic" Content="Hafif iki bant (30–200 Hz)" Foreground="#EEF3FF" Checked="AudioProfile_Checked"/>
                  <TextBlock x:Name="AudioProfileHint" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                  <TextBlock Text="Seviye işleme (Standart kapalıyken)" FontWeight="SemiBold" Margin="0,10,0,2"/>
                  <CheckBox x:Name="AudioAutoLevel" Content="Otomatik seviye: kısık sesi yükseltir, çok yükseği kısar" Foreground="#EEF3FF"
                            Checked="AudioShaping_Changed" Unchecked="AudioShaping_Changed"/>
                  <CheckBox x:Name="AudioHumSuppression" Content="Uğultu bastırma: sürekli sesi kısar, vuruşları öne çıkarır" Foreground="#EEF3FF" Margin="0,4,0,0"
                            Checked="AudioShaping_Changed" Unchecked="AudioShaping_Changed"/>
                  <TextBlock Text="İkisi de oyunun sessiz anlarında da titreşim üretebilir; sürekli titreşim hissedersen Standart'a dön." Style="{StaticResource Hint}"/>
                  <CheckBox x:Name="XboxBassTreble" Content="Gövde motorları: bas büyük motora, tiz küçük motora" Foreground="#EEF3FF" Margin="0,10,0,0"
                            IsEnabled="False" Checked="XboxBassTreble_Changed" Unchecked="XboxBassTreble_Changed"
                            AutomationProperties.Name="Xbox modunda bas büyük motora, tiz küçük motora"/>
                  <TextBlock x:Name="XboxBassTrebleHint" Style="{StaticResource Hint}" Text="Yalnız kol Xbox modundayken ve ses gövde motorlarına giderken."/>
                </StackPanel>
              </Expander>
            </StackPanel>
            <StackPanel x:Name="NativeSourceRows" Visibility="Collapsed">
              <TextBlock Text="Avuç haptiği nereden gelsin?" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <UniformGrid Columns="3">
                <RadioButton x:Name="NativeSrcGame" GroupName="NativeSrc" Tag="Game" Style="{StaticResource ChoiceCard}" Margin="0,0,8,0" Checked="NativeSource_Checked">
                  <StackPanel><TextBlock Text="Oyunun HD haptiği" FontWeight="SemiBold"/><TextBlock Text="Oyun DualSense haptiği gönderiyorsa" Style="{StaticResource Hint}"/></StackPanel>
                </RadioButton>
                <RadioButton x:Name="NativeSrcAudio" GroupName="NativeSrc" Tag="Audio" Style="{StaticResource ChoiceCard}" Margin="0,0,8,0" Checked="NativeSource_Checked">
                  <StackPanel><TextBlock Text="Oyun sesinden" FontWeight="SemiBold"/><TextBlock Text="Tetik var, haptik yoksa" Style="{StaticResource Hint}"/></StackPanel>
                </RadioButton>
                <RadioButton x:Name="NativeSrcOff" GroupName="NativeSrc" Tag="Off" Style="{StaticResource ChoiceCard}" Checked="NativeSource_Checked">
                  <StackPanel><TextBlock Text="Kapalı" FontWeight="SemiBold"/><TextBlock Text="Yalnız tetik ve titreşim" Style="{StaticResource Hint}"/></StackPanel>
                </RadioButton>
              </UniformGrid>
              <TextBlock x:Name="NativeSourceHint" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
              <Grid x:Name="NativeLevelRow" Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="NativeLevelLabel" Text="Haptik seviyesi" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Slider x:Name="NativeLevelSlider" Grid.Column="1" Minimum="10" Maximum="300" SmallChange="5" LargeChange="25" TickFrequency="5"
                        IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="NativeLevel_Changed" AutomationProperties.Name="Avuç haptiği seviyesi"/>
                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=NativeLevelSlider, StringFormat='%{0:0}'}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>

              <TextBlock Text="Oyunun diğer geri bildirimi" FontWeight="SemiBold" Margin="0,12,0,2"/>
              <CheckBox x:Name="RouteTriggers" Content="Tetik efektleri (L2/R2): Xbox modunda tetik motorlarında" Foreground="#EEF3FF" Checked="RouteSource_Changed" Unchecked="RouteSource_Changed"/>
              <CheckBox x:Name="RouteRumble" Content="Oyunun normal titreşimi (rumble): gövde motorlarında" Foreground="#EEF3FF" Margin="0,4,0,0" Checked="RouteSource_Changed" Unchecked="RouteSource_Changed"/>
              <TextBlock x:Name="RouteNativeHint" Style="{StaticResource Hint}" Margin="0,6,0,6"/>
              <Button x:Name="RouteVirtualButton" Style="{StaticResource SmallBtn}" HorizontalAlignment="Left" Click="VcBridge_Click"/>
            </StackPanel>
            </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- ===================== TEST ===================== -->
    <Grid x:Name="TestPage" Grid.Row="1" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition/></Grid.RowDefinitions>

      <!-- 1. Motor test -->
      <Border Grid.Column="0" Style="{StaticResource CardBorder}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="1 · Motor testi" Style="{StaticResource CardTitle}" VerticalAlignment="Top"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,28,0,0">
              <RadioButton x:Name="DevWolverine" Content="Wolverine" GroupName="TestDevice" Style="{StaticResource DeviceChip}"
                           IsChecked="True" Checked="TestDevice_Checked"/>
              <RadioButton x:Name="DevDualSense" Content="DualSense" GroupName="TestDevice" Style="{StaticResource DeviceChip}"
                           Checked="TestDevice_Checked"/>
              <RadioButton x:Name="DevXbox" Content="Xbox" GroupName="TestDevice" Style="{StaticResource DeviceChip}"
                           Checked="TestDevice_Checked"/>
            </StackPanel>
          </Grid>
          <TextBlock DockPanel.Dock="Top" Text="Aynı 3 vuruşluk desen seçili kolda / motorda çalar. DualSense referans, Xbox klasik titreşim." Style="{StaticResource Hint}" Margin="0,0,0,10"/>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="SensaLeftBtn" Content="◀  Sol" Style="{StaticResource Btn}" Click="SensaLeft_Click"/>
            <Button x:Name="SensaRightBtn" Content="Sağ  ▶" Style="{StaticResource Btn}" Click="SensaRight_Click"/>
