<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 26100: HIDMaestro SDK requirement (still runs on Windows 10 19041+). x64: HIDMaestro needs a 64-bit process. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RW3ProNativeDSHaptics</RootNamespace>
    <AssemblyName>RW3ProNativeDSHaptics</AssemblyName>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishTrimmed>false</PublishTrimmed>
    <HidMaestroDir>$(MSBuildThisFileDirectory)..\..\third_party\HIDMaestro\</HidMaestroDir>
  </PropertyGroup>
  <!-- HIDMaestro SDK (MIT), fetched by tools/get-hidmaestro.ps1 into third_party/HIDMaestro (not in git).
       Without it the app still builds; the virtual DualSense card then says the SDK is missing. -->
  <PropertyGroup Condition="Exists('$(HidMaestroDir)HIDMaestro.Core.dll')">
    <DefineConstants>$(DefineConstants);HAS_HIDMAESTRO</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(HidMaestroDir)HIDMaestro.Core.dll')">
    <Reference Include="HIDMaestro.Core">
      <HintPath>$(HidMaestroDir)HIDMaestro.Core.dll</HintPath>
    </Reference>
    <None Include="$(HidMaestroDir)LICENSE" Link="third_party\HIDMaestro-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(HidMaestroDir)THIRD-PARTY-NOTICES.txt" Link="third_party\HIDMaestro-THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\App.ico" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>
</Project>
