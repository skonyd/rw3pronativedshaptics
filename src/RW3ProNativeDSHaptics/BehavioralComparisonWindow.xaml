<Window x:Class="RW3ProNativeDSHaptics.BehavioralComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RW3 Pro • DualSense vs Wolverine Haptic A/B Lab"
        Width="875" Height="815" MinWidth="730" MinHeight="650"
        Background="#0A1120" Foreground="#F1F5FF" FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing">
  <Window.Resources>
    <Style x:Key="Tile" TargetType="Border">
      <Setter Property="Background" Value="#121E33"/>
      <Setter Property="CornerRadius" Value="13"/>
      <Setter Property="Padding" Value="18"/>
    </Style>
    <Style x:Key="Action" TargetType="Button">
      <Setter Property="Background" Value="#28557C"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Margin" Value="0,0,9,8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="26,24,26,30">
      <TextBlock Text="HAPTIC A/B • İKİ FİZİKSEL KONTROLCÜ" FontWeight="Bold"
                 FontSize="12" Foreground="#8CDBAE"/>
      <TextBlock Text="DualSense referans vs Wolverine V3 Pro" FontSize="25"
                 FontWeight="Bold" Margin="0,7,0,8"/>
      <TextBlock TextWrapping="Wrap" Foreground="#C0CCDC" LineHeight="20"
                 Text="USB DualSense'i bir eline, Wolverine'ı diğerine al. 10 farklı davranışsal SENTETİK sahneyi iki cihazda ayrı ayrı veya yaklaşık eşzamanlı deneyebilirsin. DualSense'e 4ch/48 kHz PCM16 referans tamponu yazılım kazancı/EQ uygulanmadan verilir. Wolverine'da aynı kaynak, mevcut KAYIPLI 50 Hz Interhaptics yöntemine dönüştürülür. Bunlar gerçek oyunlardan alınmış Sony efektleri değildir."/>
      <Border Style="{StaticResource Tile}" Margin="0,16,0,12">
        <StackPanel>
          <TextBlock Text="USB KONTROLCÜ BAĞLANTILARI" FontWeight="Bold" Foreground="#A1C8FF"/>
          <Grid Margin="0,10,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#192841" CornerRadius="8" Padding="10" Margin="0,0,5,0">
              <StackPanel>
                <TextBlock x:Name="DualSenseConnectedText" Text="○ DualSense: bağlantı kontrol ediliyor..."
                           Foreground="#EBCB99" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="DualSenseUsbDetail" FontSize="11" Foreground="#AABBD2"
                           TextWrapping="Wrap" Margin="0,5,0,0"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#192841" CornerRadius="8" Padding="10" Margin="5,0,0,0">
              <StackPanel>
                <TextBlock x:Name="WolverineConnectedText" Text="○ Wolverine V3 Pro: kontrol ediliyor..."
                           Foreground="#EBCB99" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="WolverineUsbDetail" FontSize="11" Foreground="#AABBD2"
                           TextWrapping="Wrap" Margin="0,5,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
          <Button Content="Bağlantıyı şimdi kontrol et ↻" Style="{StaticResource Action}"
                  Click="CheckConnections_Click" HorizontalAlignment="Left"/>
          <CheckBox x:Name="WiredWolverineConfirmed" Foreground="#D6E3F2" Margin="0,5,0,4">
            <TextBlock TextWrapping="Wrap"
              Text="Wolverine V3 Pro kolunun USB kablosuyla doğrudan bağlı olduğunu doğruladım (kablosuz dongle aynı USB kimliğini gösterebilir)."/>
          </CheckBox>
          <TextBlock Text="Yeşil ✓ yalnızca Windows'un mevcut USB PnP VID/PID kaydını gösterir. Sanal XInput/HID adı yeterli değildir. Fiziksel kablo ve haptic motor hareketi ayrıca doğrulanmalıdır."
                     TextWrapping="Wrap" Foreground="#9AABC5" FontSize="11"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Tile}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="1 • USB DUALSENSE REFERANS AYARI" Foreground="#A1C8FF" FontWeight="Bold"/>
          <TextBlock Text="Fiziksel DualSense'in Windows dört kanallı 48 kHz ses aygıtını seç:"
                     Foreground="#BEC9DD" Margin="0,9,0,7" TextWrapping="Wrap"/>
          <ComboBox x:Name="UsbEndpointBox" DisplayMemberPath="Display" Foreground="#152039"
                    Height="33" SelectionChanged="UsbEndpoint_Changed"/>
          <Button Content="USB / UAC aygıtlarını yenile" Style="{StaticResource Action}"
                  Click="RefreshUsb_Click" HorizontalAlignment="Left" Margin="0,9,0,5"/>
          <CheckBox x:Name="ConfirmUsbCheck" Foreground="#D6E3F2" Margin="0,4,0,6">
            <TextBlock Text="Bu ses çıkışının fiziksel USB DualSense'e ait olduğunu kontrol ettim."
                       TextWrapping="Wrap"/>
          </CheckBox>
          <CheckBox x:Name="ExclusiveCheck" Foreground="#A8E0CB" IsChecked="True" Margin="0,4,0,6">
            <TextBlock Text="Öncelikli: Exclusive PCM16 • 4ch/48 kHz (desteklenmiyorsa hata ver, otomatik Shared'a geçme)"
                       TextWrapping="Wrap"/>
          </CheckBox>
          <TextBlock TextWrapping="Wrap" Foreground="#96A9C0" FontSize="11"
                     Text="Shared mod isteğe bağlıdır; Windows ses sürücüsü PCM'yi yeniden işleyebilir. Exclusive mod başka uygulamaların DualSense ses kanalını geçici kullanmasını engelleyebilir. RW3 referans PCM'ye kendi kazanç/filtre/mikserini uygulamaz; donanımda bit-perfect sonucu test gerektirir."/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Tile}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="2 • SAHNE VE ÇALIŞTIRMA" Foreground="#A1C8FF" FontWeight="Bold"/>
          <ComboBox x:Name="SceneBox" DisplayMemberPath="Name" Height="34"
                    Foreground="#142039" Margin="0,11,0,5"
                    SelectionChanged="Scene_Changed"/>
          <TextBlock x:Name="SceneDetails" TextWrapping="Wrap" Foreground="#BBCBDC"
                     Margin="0,5,0,10"/>
          <TextBlock Text="Hedef kontrolcü" Foreground="#D4DDEA" Margin="0,0,0,6"/>
          <ComboBox x:Name="TargetBox" Height="34" Foreground="#142039">
            <ComboBoxItem Content="İki kol birlikte • yaklaşık eşzamanlı A/B"/>
            <ComboBoxItem Content="Yalnızca USB DualSense • doğrudan PCM referansı"/>
            <ComboBoxItem Content="Yalnızca Wolverine • kayıplı Sensa karşılığı"/>
          </ComboBox>
          <TextBlock x:Name="WolverineLevelLabel" Margin="0,13,0,5"
                     FontWeight="SemiBold" Text="Wolverine karşılaştırma seviyesi: %65"/>
          <Slider x:Name="WolverineLevel" Minimum="0" Maximum="100" Value="65"
                  TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="WolverineLevel_Changed"/>
          <TextBlock Text="Wolverine test seviyesi, ana ekrandaki genel RW3 seviyesi ile birlikte uygulanır. DualSense referansı SABİTTİR."
                     TextWrapping="Wrap" Foreground="#96B4CA" FontSize="11" Margin="0,5,0,9"/>
          <CheckBox x:Name="ConfirmSensaCheck" Foreground="#D6E3F2" Margin="0,2,0,10">
            <TextBlock Text="Razer SDK'nin yüklü ve Wolverine'ın PC modunda olduğunu doğruladım; kısa, düşük seviyeli sentetik Sensa darbelerini kabul ediyorum."
                       TextWrapping="Wrap"/>
          </CheckBox>
          <WrapPanel>
            <Button x:Name="PlayButton" Content="▶ Seçili sahneyi çalıştır" Style="{StaticResource Action}"
                    Background="#2C735C" Click="Play_Click"/>
            <Button x:Name="StopButton" Content="■ Anında durdur / sıfırla" Style="{StaticResource Action}"
                    Background="#77394B" Click="Stop_Click"/>
          </WrapPanel>
          <TextBlock x:Name="PlaybackStatus" Foreground="#E3C696" TextWrapping="Wrap"
                     Margin="0,4,0,2" Text="Henüz sahne çalıştırılmadı."/>
          <TextBlock Foreground="#A9B8D0" FontSize="11" TextWrapping="Wrap"
                     Text="İki ayrı Windows/sürücü hattı yazılımla başlatılır; gerçek donanım çıkışları örnek hassasiyetinde senkronize değildir. Razer motor hareketi komut kabulünden çıkarılamaz."/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Tile}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="3 • ELLE FİZİKSEL HİS KARŞILAŞTIRMASI" Foreground="#A1C8FF" FontWeight="Bold"/>
          <TextBlock Text="Her iki kola 1–5 puan ver: 1 zayıf/belirsiz, 5 belirgin/ayrıntılı. Değerlendirme öznel his kaydıdır, otomatik sadakat ölçümü değildir."
                     Foreground="#B8C7DD" TextWrapping="Wrap" Margin="0,9,0,10"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="185"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="1" Text="USB DualSense" FontWeight="Bold" Foreground="#A5E1CF" Margin="4,3,0,8"/>
            <TextBlock Grid.Column="2" Text="Wolverine V3 Pro" FontWeight="Bold" Foreground="#B9C9FF" Margin="4,3,0,8"/>
            <TextBlock Grid.Row="1" Text="Doku / ayrıntı" Margin="0,8"/>
            <TextBlock Grid.Row="2" Text="Darbe / tepki" Margin="0,8"/>
            <TextBlock Grid.Row="3" Text="Sol / sağ ayrımı" Margin="0,8"/>
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="DsTexture" Margin="4" Foreground="#142039"/>
            <ComboBox Grid.Row="1" Grid.Column="2" x:Name="RwTexture" Margin="4" Foreground="#142039"/>
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="DsImpact" Margin="4" Foreground="#142039"/>
            <ComboBox Grid.Row="2" Grid.Column="2" x:Name="RwImpact" Margin="4" Foreground="#142039"/>
            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="DsStereo" Margin="4" Foreground="#142039"/>
            <ComboBox Grid.Row="3" Grid.Column="2" x:Name="RwStereo" Margin="4" Foreground="#142039"/>
          </Grid>
          <TextBlock Text="Ek gözlemler / hangi kolun hangi elde olduğu:" Foreground="#C8D2E0"
                     Margin="0,12,0,5"/>
          <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap"
                   Height="66" VerticalScrollBarVisibility="Auto" Foreground="#1B2A40"
                   Background="#E1E8F4"/>
          <WrapPanel Margin="0,13,0,0">
            <Button x:Name="SaveButton" Content="Bu sahnenin puanlarını kaydet" Style="{StaticResource Action}"
                    Background="#2C735C" Click="Save_Click"/>
            <Button Content="Yerel test kayıtlarını aç" Style="{StaticResource Action}" Click="OpenResults_Click"/>
          </WrapPanel>
          <TextBlock x:Name="SaveStatus" Foreground="#A5E1CF" TextWrapping="Wrap" Margin="0,6,0,0"/>
          <TextBlock Text="Yalnızca puanlar, cihaz adı, yöntem ve yerel zaman saklanır; haptic PCM veya kişisel veri sunucuya gönderilmez."
                     FontSize="11" Foreground="#9AABC5" TextWrapping="Wrap" Margin="0,7,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>