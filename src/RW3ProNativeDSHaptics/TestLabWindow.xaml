<Window x:Class="RW3ProNativeDSHaptics.TestLabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RW3 Pro · Haptic Test Lab" Width="740" Height="695"
        MinWidth="670" MinHeight="620" FontFamily="Segoe UI"
        Background="#0A1120" Foreground="#F1F5FF"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing">
  <Window.Resources>
    <Style x:Key="Tile" TargetType="Border">
      <Setter Property="Background" Value="#121E33"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="19"/>
    </Style>
    <Style x:Key="LabButton" TargetType="Button">
      <Setter Property="Background" Value="#245078"/>
      <Setter Property="Foreground" Value="#F3F7FF"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="15,12"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border CornerRadius="10" Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.86"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="30,26,30,30">
      <TextBlock Text="HAPTIC TEST LAB" FontSize="13" FontWeight="Bold" Foreground="#7FAFFF"/>
      <TextBlock Text="Oyun açmadan test" FontSize="28" FontWeight="Bold" Margin="0,7,0,10"/>
      <TextBlock x:Name="ModeHeader" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock x:Name="ModeDescription" Margin="0,8,0,18" TextWrapping="Wrap"
                 Foreground="#B4C0D5" LineHeight="21"/>
      <Border Style="{StaticResource Tile}" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="KANAL AYRIMI" FontSize="12" FontWeight="Bold" Foreground="#9CB2D4"/>
          <TextBlock Text="Test sırasında kolu elinde tut. Sol ve sağı ayrı dene; ikisini hissettiğini işaretlemeden tam başarılı sayılmayacak."
                     Margin="0,7,0,15" TextWrapping="Wrap" Foreground="#B4C0D5" FontSize="12"/>
          <WrapPanel>
            <Button x:Name="LeftButton" Content="◀  Sol kanal" Style="{StaticResource LabButton}"
                    Click="Left_Click"/>
            <Button x:Name="RightButton" Content="Sağ kanal  ▶" Style="{StaticResource LabButton}"
                    Click="Right_Click"/>
            <Button x:Name="BothButton" Content="Sol → Sağ sıralı" Style="{StaticResource LabButton}"
                    Background="#4B3B74" Click="Both_Click"/>
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Tile}" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="KANIT VE HİS TEYİDİ" FontSize="12" FontWeight="Bold" Foreground="#9CB2D4"/>
          <TextBlock x:Name="LeftResult" Text="Sol: test edilmedi" FontWeight="SemiBold" FontSize="14"
                     Margin="0,11,0,8" TextWrapping="Wrap"/>
          <TextBlock x:Name="RightResult" Text="Sağ: test edilmedi" FontWeight="SemiBold" FontSize="14"
                     Margin="0,0,0,8" TextWrapping="Wrap"/>
          <TextBlock x:Name="OverallResult" Text="Her kanal için dijital doğrulama ve fiziksel his ayrıdır."
                     TextWrapping="Wrap" Foreground="#F3C68A" Margin="0,5,0,4" FontSize="13"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Tile}" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="NATIVE STEREO PCM REFERANS TESTİ" FontSize="12" FontWeight="Bold" Foreground="#9CB2D4"/>
          <TextBlock Text="48 kHz stereo sentetik dalga biçimlerini oyun açmadan oluşturabiliriz. Bu veri gerçek oyun komutu değildir; kaynağın sol/sağ ayrımını doğrular. Wolverine'e HD PCM gönderme arayüzü henüz doğrulanmadı."
                     TextWrapping="Wrap" Margin="0,8,0,12" Foreground="#B4C0D5"/>
          <WrapPanel>
            <Button Content="Sol referans WAV" Style="{StaticResource LabButton}" Click="ExportLeft_Click"/>
            <Button Content="Sağ referans WAV" Style="{StaticResource LabButton}" Click="ExportRight_Click"/>
            <Button Content="Resmî Razer Sensa TechDemo" Style="{StaticResource LabButton}"
                    Background="#365E4A" Click="OfficialSensa_Click"/>
          </WrapPanel>
          <TextBlock x:Name="FixtureStatus" Margin="0,12,0,0" Foreground="#AAC7ED" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <TextBlock x:Name="OperationText" TextWrapping="Wrap" Foreground="#AAB9CE" Margin="0,0,0,12"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Tanılama raporunu kopyala" Style="{StaticResource LabButton}"
                Click="Copy_Click"/>
        <Button Content="Kapat" Style="{StaticResource LabButton}" Click="Close_Click"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>