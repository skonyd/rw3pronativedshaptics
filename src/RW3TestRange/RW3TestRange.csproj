<Project Sdk="Microsoft.NET.Sdk">
  <!-- Small test game ("Şişe Atışı"): drives controllers the way real games do (XInput, GameInput with impulse
       triggers, DualSense HID output report 0x02, DualSense HD haptics on the 4-channel audio endpoint) and logs
       every feedback it sends, to test RW3 end to end. Independent of RW3's code on purpose. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041: Windows.Gaming.Input (the PowerA-style trigger path of the quick test) -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RW3TestRange</RootNamespace>
    <AssemblyName>RW3TestRange</AssemblyName>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- RW3's theme, shared so the game looks like RW3's main window -->
    <Page Include="..\RW3ProNativeDSHaptics\Theme.xaml" Link="Theme.xaml" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Recorded CC0 sounds and music (Sounds/CREDITS.md); missing files fall back to the synthesised ones -->
    <None Include="Sounds\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
